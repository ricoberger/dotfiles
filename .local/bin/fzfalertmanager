#!/usr/bin/env bash

# fzfalertmanager - Fuzzy Finder for Alertmanager
#
# Usage: fzfalertmanager [view <alertmanager-name> <fingerprint>]

SCRIPT="$(realpath "$0")"

# ---------- Configuration ----------

# JSON config (required), e.g. set in a shell startup file via a quoted heredoc
# (<<'EOF') so the shell does not touch $, quotes or backslashes:
#
#   export FZFALERTMANAGER_CONFIG="$(cat <<'EOF'
#   {
#     "alertmanagers": [
#       { "name": "prod", "url": "https://alertmanager.example.com",
#         "auth": { "type": "basic", "username": "me",
#                   "password": "${AM_PASSWORD}" } },
#       { "name": "prod/de1", "grafanaInstance": "prod-de1" }
#     ],
#     "filters": [
#       { "name": "critical", "alertmanagers": ["prod"], "states": ["active"],
#         "receivers": ["slack"], "matchers": ["severity=~\"critical|error\""] }
#     ]
#   }
#   EOF
#   )"
#
# - alertmanagers: name, url and auth; queried at {url}/api/v2/alerts, or with
#   "grafana": true at {url}/api/alertmanager/{datasource}/api/v2/alerts
#   (datasource UID, default: grafana). Auth types: none (default), basic
#   (username, password), token (token), tokenFile (path, re-read on every
#   refresh), tokenCommand (command, run once per session); ${VAR} in
#   username, password, token and path is replaced from the environment.
#   Alternatively grafanaInstance takes url and tokenCommand from the
#   GRAFANA_INSTANCES entry of that name (implies grafana: true, cannot be
#   combined with url / auth / grafana, name defaults to the instance name).
# - filters: name plus optional alertmanagers (names), states (active,
#   suppressed, unprocessed), receivers (any of them) and matchers (all must
#   match); omitted means all. Matchers use Alertmanager semantics (=, !=, =~,
#   !~; regexes fully anchored, a missing label matches "").
FZFALERTMANAGER_CONFIG="${FZFALERTMANAGER_CONFIG:-}"
# Seconds between automatic refreshes of the alerts list (override via
# FZFALERTMANAGER_REFRESH_INTERVAL).
FZFALERTMANAGER_REFRESH_INTERVAL="${FZFALERTMANAGER_REFRESH_INTERVAL:-180}"

# Nerd font glyphs used in bash-side prompts / labels. Defined via byte escapes
# so they do not depend on a bash that supports the \u / \U printf escapes.
ICON_ALERT=$'\xef\x81\xb1'   # warning triangle
ICON_FILTER=$'\xef\x82\xb0'  # funnel / filter
ICON_AM=$'\xef\x83\xb3'      # bell (alertmanager)

# Per-session working directory (config, auth headers, alert cache). Set up in
# the main mode and exported to the fzf child preview/action processes. It is a
# fresh mktemp directory per run, removed on exit; to inspect it while the
# script is running, find it with: ls -d "$TMPDIR"fzfalertmanager.*
FZFALERTMANAGER_DIR="${FZFALERTMANAGER_DIR:-}"
# Index of the only alertmanager to fetch, set by the view subcommand and
# exported to the fzf reload processes. Empty fetches all alertmanagers.
FZFALERTMANAGER_ONLY="${FZFALERTMANAGER_ONLY:-}"

# ---------- jq library ----------
#
# Shared jq definitions, prepended to every program run against the alert cache
# (see jq_alerts). $cfg is the normalized config, $errs maps an alertmanager
# index (as string) to the error of its last refresh.

JQ_LIB='
def reset: "\u001b[0m";
def dim: "\u001b[90m";
def rpad($n): . + (" " * ([($n - length), 0] | max));
def oneline: gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "");
def capitalize: (.[0:1] | ascii_upcase) + .[1:];

# RFC 3339 timestamp (optional fraction, Z or +hh:mm offset) -> epoch seconds.
def epoch:
  (try (
    capture("^(?<d>[0-9-]+T[0-9:]+)(\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:?[0-9]{2})?$")
    | ((.d + "Z") | fromdateiso8601)
      - (if (.z // "Z") == "Z" then 0
         else (.z | capture("(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})")
               | ((.h | tonumber) * 3600 + (.m | tonumber) * 60)
                 * (if .s == "-" then -1 else 1 end))
         end)
  ) catch null) // null;

def ago:
  epoch as $e
  | if $e == null then "?"
    else (now - $e) as $s
      | if $s < 0 then "0s"
        elif $s < 60 then "\($s | floor)s"
        elif $s < 3600 then "\(($s / 60) | floor)m"
        elif $s < 86400 then "\(($s / 3600) | floor)h"
        else "\(($s / 86400) | floor)d" end
    end;

def severity: .labels.severity // "unknown";
def sevrank:
  {"critical": 0, "error": 1, "warning": 2, "info": 3}[severity] // 4;
def sevcolor:
  {"critical": "\u001b[35m", "error": "\u001b[31m", "warning": "\u001b[33m",
   "info": "\u001b[34m"}[severity] // dim;
def silenced: ((.status.silencedBy // []) | length) > 0;
def inhibited: ((.status.inhibitedBy // []) | length) > 0;
def secondary:
  (.annotations.summary // .annotations.description // "") | oneline;

# Label matchers use Alertmanager semantics: regexes are fully anchored and a
# missing label is treated as the empty string.
def matcher_ok($m):
  (.labels[$m.k] // "") as $v
  | if $m.op == "=" then $v == $m.v
    elif $m.op == "!=" then $v != $m.v
    elif $m.op == "=~" then ($v | test("^(?:" + $m.v + ")$"))
    else ($v | test("^(?:" + $m.v + ")$") | not) end;

def in_filter($f):
  . as $a
  | (($f.alertmanagers | length) == 0 or ($f.alertmanagers | index($a._am)) != null)
    and (($f.states | length) == 0 or ($f.states | index($a.status.state)) != null)
    and (($f.receivers | length) == 0
         or ([$a.receivers[]?.name] as $r | any($f.receivers[]; . as $x | ($r | index($x)) != null)))
    and all($f.matchers[]; . as $m | $a | matcher_ok($m));

def alerts_for($type; $idx):
  if $type == "alertmanager" then map(select(._am == $idx))
  else $cfg.filters[$idx] as $f | map(select(in_filter($f))) end;

def am: $cfg.alertmanagers[._am];
def dsname: ._ds // am.datasource;

def link($key):
  am as $am
  | if $key == "source" then (.generatorURL // "")
    elif $key == "runbook" then (.annotations.runbook_url // "")
    elif $key == "silence" then
      (.labels | to_entries | sort_by(.key)) as $l
      | if $am.grafana then
          $am.url + "/alerting/silence/new?alertmanager=" + (dsname | @uri) + "&"
          + ($l | map("matcher=" + (.key | @uri) + "%3D" + (.value | @uri)) | join("&"))
        else
          $am.url + "/#/silences/new?filter=%7B"
          + ($l | map((.key | @uri) + "%3D%22" + (.value | @uri) + "%22") | join("%2C%20"))
          + "%7D"
        end
    elif $key == "dashboard" or $key == "panel" then
      (.annotations.__dashboardUid__ // "") as $d
      | (.annotations.__panelId__ // "") as $p
      | if ($am.grafana | not) or $d == "" then ""
        elif $key == "dashboard" then $am.url + "/d/" + $d
        elif $p == "" then ""
        else $am.url + "/d/" + $d + "?viewPanel=" + $p end
    else "" end;

def markdown:
  am as $am
  | (.annotations.summary // "" | gsub("^\\s+|\\s+$"; "")) as $sum
  | (.annotations.description // "" | gsub("^\\s+|\\s+$"; "")) as $desc
  | (.startsAt | epoch) as $start
  | [
      "# " + (.labels.alertname // "unknown"),
      "",
      "- **Alertmanager:** " + $am.name,
      (if $am.grafana then "- **Grafana URL:** " else "- **Alertmanager URL:** " end) + $am.url,
      (if $am.grafana then "- **Grafana Alertmanager Datasource:** " + dsname else empty end),
      "- **Severity:** " + severity,
      "- **State:** " + ((.status.state // "unknown") | capitalize),
      (if silenced then "- **Silenced by:** " + (.status.silencedBy | join(", ")) else empty end),
      (if inhibited then "- **Inhibited by:** " + (.status.inhibitedBy | join(", ")) else empty end),
      "- **Started:** "
        + (if $start == null then (.startsAt // "?")
           else ($start | strflocaltime("%Y-%m-%d %H:%M")) end)
        + " (" + (.startsAt | ago) + " ago)",
      (if ((.receivers // []) | length) > 0
       then "- **Receivers:** " + ([.receivers[].name] | join(", ")) else empty end),
      (if (.generatorURL // "") != "" then "- **Source:** " + .generatorURL else empty end),
      (if $sum != "" then "", "## Summary", "", $sum else empty end),
      (if $desc != "" then "", "## Description", "", $desc else empty end),
      (if ((.labels // {}) | length) > 0 then
         "", "## Labels", "",
         (.labels | to_entries | sort_by(.key)[] | "- `\(.key)`: `\(.value)`")
       else empty end),
      ((.annotations // {}) | del(.summary, .description)) as $ann
      | (if ($ann | length) > 0 then
           "", "## Annotations", "",
           ($ann | to_entries | sort_by(.key)[] | "- `\(.key)`: `\(.value)`")
         else empty end)
    ]
  | join("\n");
'

# Validates the raw config (JSON) and emits the normalized config, or
# {"errors": [...]} when it is invalid. Alertmanagers with a grafanaInstance
# take their url and tokenCommand from the GRAFANA_INSTANCES environment
# variable (shared with the sre-grafana skills). Filter alertmanager references
# are resolved to indexes and matcher strings are parsed into {k, op, v}.
JQ_NORMALIZE='
def parse_matcher:
  (if type == "string" then . else "" end)
  | capture("^\\s*(?<k>[a-zA-Z_][a-zA-Z0-9_]*)\\s*(?<op>=~|!~|!=|=)\\s*(?<v>.*?)\\s*$")
  | if (.v | test("^\".*\"$")) then .v = .v[1:-1] else . end;
def regex_ok($re): (try (("" | test("^(?:" + $re + ")$")) | true) catch false);

(. // {}) as $c
| ($ENV.GRAFANA_INSTANCES // null) as $giraw
| (if $giraw == null then null else (try ($giraw | fromjson) catch null) end) as $gi
| [($c.alertmanagers // [])[]
    | if has("grafanaInstance") then
        ((.grafanaInstance // "") | tostring) as $g
        | (if ($gi | type) == "object" then $gi[$g] else null end) as $inst
        | {name: ((.name // $g) | tostring),
           url: (($inst.url // "") | tostring | sub("/+$"; "")),
           grafana: true,
           datasource: ((.datasource // "grafana") | tostring),
           auth: {type: "tokenCommand", command: ($inst.auth.tokenCommand // "")},
           grafanaInstance: $g,
           _err: (if has("url") or has("auth") or has("grafana")
                  then "grafanaInstance cannot be combined with url, auth or grafana"
                  elif $giraw == null then "GRAFANA_INSTANCES is not set"
                  elif ($gi | type) != "object" then "GRAFANA_INSTANCES is not a valid JSON object"
                  elif $inst == null then "grafanaInstance \($g | tojson) not found in GRAFANA_INSTANCES"
                  elif (($inst.url // "") == "") or (($inst.auth.tokenCommand // "") == "")
                  then "GRAFANA_INSTANCES entry \($g | tojson) needs url and auth.tokenCommand"
                  else null end)}
      else
        {name: ((.name // "") | tostring),
         url: ((.url // "") | tostring | sub("/+$"; "")),
         grafana: (.grafana // false),
         datasource: ((.datasource // "grafana") | tostring),
         auth: (.auth // {type: "none"}),
         _err: null}
      end] as $ams
| ($ams | map(.name)) as $names
| [($c.filters // [])[]
    | {name: ((.name // "") | tostring),
       alertmanagers: (.alertmanagers // []),
       states: (.states // []),
       receivers: (.receivers // []),
       matchers: [(.matchers // [])[] | {raw: ., parsed: ([parse_matcher] | first)}]}] as $fs
| [
    (if ($ams | length) == 0 then "no alertmanagers configured" else empty end),
    ($names | group_by(.) | map(select(length > 1)[0])[]
      | "duplicate alertmanager name: \(.)"),
    ($fs | map(.name) | group_by(.) | map(select(length > 1)[0])[]
      | "duplicate filter name: \(.)"),
    ($ams | to_entries[] | "alertmanagers[\(.key)]" as $p | .value
      | (if .name == "" then "\($p): name is required" else empty end),
        if ._err != null then "\($p): \(._err)" else
        (if (.url | test("^https?://") | not)
         then "\($p): url must start with http:// or https://" else empty end),
        (.auth.type // "none") as $t
        | (if ($t | IN("none", "basic", "token", "tokenFile", "tokenCommand") | not)
           then "\($p): unknown auth type \($t | tojson)"
           elif $t == "basic" and ((.auth.username // "") == "" or (.auth.password // "") == "")
           then "\($p): basic auth requires username and password"
           elif $t == "token" and (.auth.token // "") == ""
           then "\($p): token auth requires token"
           elif $t == "tokenFile" and (.auth.path // "") == ""
           then "\($p): tokenFile auth requires path"
           elif $t == "tokenCommand" and (.auth.command // "") == ""
           then "\($p): tokenCommand auth requires command"
           else empty end) end),
    ($fs | to_entries[] | "filters[\(.key)]" as $p | .value
      | (if .name == "" then "\($p): name is required" else empty end),
        (.alertmanagers[] | select(IN($names[]) | not)
          | "\($p): unknown alertmanager \(tojson)"),
        (.states[] | select(IN("active", "suppressed", "unprocessed") | not)
          | "\($p): unknown state \(tojson) (use active, suppressed or unprocessed)"),
        (.matchers[]
          | if .parsed == null then "\($p): invalid matcher \(.raw | tojson)"
            elif (.parsed.op | IN("=~", "!~")) and (regex_ok(.parsed.v) | not)
            then "\($p): invalid regex in matcher \(.raw | tojson)"
            else empty end))
  ] as $errors
| if ($errors | length) > 0 then {errors: $errors}
  else {
    alertmanagers: ($ams | map(del(._err))),
    filters: [$fs[]
      | .alertmanagers |= map(. as $n | $names | index($n))
      | .matchers |= map(.parsed)]
  } end
'

# ---------- Helpers ----------

# Print a status message and wait for a keypress. Used by action handlers that
# run on fzf's alternate screen so a transient message is seen before fzf
# redraws the list.
pause_msg() {
  printf '%s\n' "$1"
  read -n 1 -s -r -p "Press any key to continue..."
}

# Render markdown read from stdin with md, falling back to the raw markdown when
# md is not installed.
md_render() {
  if command -v md >/dev/null 2>&1; then
    MD_WORD_WRAP="${FZF_PREVIEW_COLUMNS:-80}" md
  else
    cat
  fi
}

# Read a value from the normalized config: cfg <jq-filter> [jq args...].
cfg() {
  local filter="$1"
  shift
  jq -r "$@" "$filter" "$FZFALERTMANAGER_DIR/config.json"
}

# Run a jq program against the alert cache with the shared library, the config
# ($cfg) and the per-alertmanager refresh errors ($errs) in scope:
# jq_alerts <jq-filter> [jq args...].
jq_alerts() {
  local filter="$1"
  shift
  jq -r "$@" \
    --slurpfile c "$FZFALERTMANAGER_DIR/config.json" \
    --slurpfile e "$FZFALERTMANAGER_DIR/errors.json" \
    '$c[0] as $cfg | $e[0] as $errs | '"$JQ_LIB $filter" \
    "$FZFALERTMANAGER_DIR/alerts.json"
}

# Expand ${VAR} references in a config value. Only plain variable names are
# substituted (no eval); referencing an unset variable is an error.
expand_env() {
  local s="$1" out="" pre rest name
  while [[ "$s" == *'${'* ]]; do
    pre="${s%%\$\{*}"
    rest="${s#*\$\{}"
    if [[ "$rest" =~ ^([A-Za-z_][A-Za-z0-9_]*)\}(.*)$ ]]; then
      name="${BASH_REMATCH[1]}"
      s="${BASH_REMATCH[2]}"
      if [[ -z "${!name+x}" ]]; then
        printf 'environment variable %s is not set\n' "$name" >&2
        return 1
      fi
      out+="$pre${!name}"
    else
      out+="$pre\${"
      s="$rest"
    fi
  done
  printf '%s' "$out$s"
}

# Load, validate and normalize the config from FZFALERTMANAGER_CONFIG into
# $FZFALERTMANAGER_DIR/config.json.
load_config() {
  local raw out
  if [[ -z "$FZFALERTMANAGER_CONFIG" ]]; then
    echo "FZFALERTMANAGER_CONFIG is not set (see --help)" >&2
    exit 1
  fi
  if ! raw="$(printf '%s' "$FZFALERTMANAGER_CONFIG" | jq -c '.' 2>&1)"; then
    echo "FZFALERTMANAGER_CONFIG is not valid JSON: $raw" >&2
    exit 1
  fi

  if ! out="$(printf '%s' "$raw" | jq "$JQ_NORMALIZE" 2>&1)"; then
    echo "Could not load config: $out" >&2
    exit 1
  fi
  if printf '%s' "$out" | jq -e 'has("errors")' >/dev/null; then
    echo "Invalid config:" >&2
    printf '%s' "$out" | jq -r '.errors[] | "  - " + .' >&2
    exit 1
  fi
  printf '%s\n' "$out" > "$FZFALERTMANAGER_DIR/config.json"
}

# Resolve the credentials of every alertmanager (or only of the one at the
# given index) once per session and store the
# resulting Authorization header in auth/<idx> (the session dir is 0700).
# tokenFile auth only stores the expanded path, the file is re-read on every
# refresh so rotated tokens are picked up. A failure is recorded in
# auth/<idx>.err and reported as that alertmanager's refresh error.
resolve_auth() {
  local n idx name type user pass token path cmd err
  n="$(cfg '.alertmanagers | length')"
  idx=0
  if [[ -n "$1" ]]; then
    idx="$1"
    n=$((idx + 1))
  fi
  for (( ; idx < n; idx++)); do
    name="$(cfg '.alertmanagers[$i].name' --argjson i "$idx")"
    type="$(cfg '.alertmanagers[$i].auth.type // "none"' --argjson i "$idx")"
    err=""
    case "$type" in
      basic)
        if ! user="$(expand_env "$(cfg '.alertmanagers[$i].auth.username' --argjson i "$idx")" 2>&1)"; then
          err="$user"
        elif ! pass="$(expand_env "$(cfg '.alertmanagers[$i].auth.password' --argjson i "$idx")" 2>&1)"; then
          err="$pass"
        else
          printf 'Authorization: Basic %s' "$(printf '%s:%s' "$user" "$pass" | base64 | tr -d '\n')" \
            > "$FZFALERTMANAGER_DIR/auth/$idx"
        fi
        ;;
      token)
        if token="$(expand_env "$(cfg '.alertmanagers[$i].auth.token' --argjson i "$idx")" 2>&1)"; then
          printf 'Authorization: Bearer %s' "$token" > "$FZFALERTMANAGER_DIR/auth/$idx"
        else
          err="$token"
        fi
        ;;
      tokenFile)
        if path="$(expand_env "$(cfg '.alertmanagers[$i].auth.path' --argjson i "$idx")" 2>&1)"; then
          [[ "$path" == "~/"* ]] && path="$HOME/${path#\~/}"
          printf '%s' "$path" > "$FZFALERTMANAGER_DIR/auth/$idx.path"
        else
          err="$path"
        fi
        ;;
      tokenCommand)
        cmd="$(cfg '.alertmanagers[$i].auth.command' --argjson i "$idx")"
        if token="$(bash -c "$cmd")" && token="$(printf '%s' "$token" | tr -d '\r\n')" && [[ -n "$token" ]]; then
          printf 'Authorization: Bearer %s' "$token" > "$FZFALERTMANAGER_DIR/auth/$idx"
        else
          err="tokenCommand failed or returned an empty token"
        fi
        ;;
    esac
    if [[ -n "$err" ]]; then
      printf '%s: auth: %s\n' "$name" "$err" >&2
      printf 'auth: %s' "$err" > "$FZFALERTMANAGER_DIR/auth/$idx.err"
    fi
  done
}

# Echo the Authorization header for an alertmanager (empty without auth).
auth_header() {
  local idx="$1" path token
  if [[ -f "$FZFALERTMANAGER_DIR/auth/$idx.err" ]]; then
    cat "$FZFALERTMANAGER_DIR/auth/$idx.err" >&2
    return 1
  fi
  if [[ -f "$FZFALERTMANAGER_DIR/auth/$idx.path" ]]; then
    path="$(cat "$FZFALERTMANAGER_DIR/auth/$idx.path")"
    if [[ ! -r "$path" ]]; then
      printf 'auth: token file not readable: %s' "$path" >&2
      return 1
    fi
    token="$(tr -d '\r\n' < "$path")"
    printf 'Authorization: Bearer %s' "$token"
  elif [[ -f "$FZFALERTMANAGER_DIR/auth/$idx" ]]; then
    cat "$FZFALERTMANAGER_DIR/auth/$idx"
  fi
}

# GET <path> from an alertmanager into <out>. The Authorization header is
# passed to curl on stdin so it never shows up in the process list.
am_get() {
  local idx="$1" path="$2" out="$3" url header
  url="$(cfg '.alertmanagers[$i].url' --argjson i "$idx")"
  header="$(auth_header "$idx")" || return 1
  if [[ -n "$header" ]]; then
    printf '%s\n' "$header" | curl -fsS --max-time 10 -H @- -o "$out" "$url$path"
  else
    curl -fsS --max-time 10 -o "$out" "$url$path"
  fi
}

# Fetch the alerts of one alertmanager into raw/<idx>.json, tagging every alert
# with its alertmanager index (_am) and the resolved Grafana datasource name
# (_ds, used for silence links). On failure the previous alerts are kept and
# the error is written to raw/<idx>.err.
fetch_am() {
  local idx="$1" dir="$FZFALERTMANAGER_DIR" grafana ds dsname="" path err tmp
  tmp="$dir/raw/$idx.tmp"
  grafana="$(cfg '.alertmanagers[$i].grafana' --argjson i "$idx")"
  ds="$(cfg '.alertmanagers[$i].datasource' --argjson i "$idx")"

  if [[ "$grafana" == "true" ]]; then
    path="/api/alertmanager/$ds/api/v2/alerts"
    # Grafana's silence page needs the datasource name, not its UID. The
    # built-in "grafana" alertmanager is not a datasource. Cache on success
    # only, so a failed lookup is retried on the next refresh.
    dsname="$ds"
    if [[ "$ds" != "grafana" ]]; then
      if [[ -f "$dir/ds/$idx" ]]; then
        dsname="$(cat "$dir/ds/$idx")"
      elif am_get "$idx" "/api/datasources/uid/$ds" "$tmp" 2>/dev/null &&
        jq -re '.name // empty' "$tmp" > "$dir/ds/$idx.tmp" 2>/dev/null; then
        mv "$dir/ds/$idx.tmp" "$dir/ds/$idx"
        dsname="$(cat "$dir/ds/$idx")"
      fi
    fi
  else
    path="/api/v2/alerts"
  fi

  if ! err="$(am_get "$idx" "$path" "$tmp" 2>&1)"; then
    printf '%s' "${err:-request failed}" > "$dir/raw/$idx.err"
  elif jq -c --argjson i "$idx" --arg ds "$dsname" \
    'if type == "array" then map(. + {_am: $i, _ds: $ds}) else error("not an array") end' \
    "$tmp" > "$dir/raw/$idx.json.tmp" 2>/dev/null; then
    mv "$dir/raw/$idx.json.tmp" "$dir/raw/$idx.json"
    rm -f "$dir/raw/$idx.err"
  else
    printf 'invalid response from %s' "$path" > "$dir/raw/$idx.err"
  fi
  rm -f "$tmp" "$dir/raw/$idx.json.tmp"
}

# Fetch all alertmanagers (or only the one at index $FZFALERTMANAGER_ONLY, used
# by the view subcommand) in parallel and atomically rebuild alerts.json and
# errors.json. A refresh that is already running (e.g. auto-refresh overlapping
# a manual reload) is not started twice.
refresh() {
  local dir="$FZFALERTMANAGER_DIR" first=0 n idx files f
  mkdir "$dir/lock" 2>/dev/null || return 0
  n="$(cfg '.alertmanagers | length')"
  if [[ -n "$FZFALERTMANAGER_ONLY" ]]; then
    first="$FZFALERTMANAGER_ONLY"
    n=$((first + 1))
  fi
  for ((idx = first; idx < n; idx++)); do
    fetch_am "$idx" &
  done
  wait

  files=()
  for ((idx = first; idx < n; idx++)); do
    [[ -f "$dir/raw/$idx.json" ]] && files+=("$dir/raw/$idx.json")
  done
  if [[ ${#files[@]} -gt 0 ]]; then
    jq -s 'add' "${files[@]}" > "$dir/alerts.json.tmp"
  else
    printf '[]\n' > "$dir/alerts.json.tmp"
  fi
  mv "$dir/alerts.json.tmp" "$dir/alerts.json"

  for ((idx = first; idx < n; idx++)); do
    f="$dir/raw/$idx.err"
    [[ -f "$f" ]] && jq -Rs --arg i "$idx" '{($i): .}' "$f"
  done | jq -s 'add // {}' > "$dir/errors.json.tmp"
  mv "$dir/errors.json.tmp" "$dir/errors.json"

  rmdir "$dir/lock"
}

# ---------- List: combined filters + alertmanagers ----------
#
# Called as: fzfalertmanager __list-sources [refresh]
# Emits TAB-separated rows: <type>\t<idx>\t<name>\t<display>
#   type    : "filter" | "alertmanager"
#   idx     : index into the config's filters / alertmanagers
#   name    : raw display name (used for the border label)
#   display : coloured "name (count)" shown via --with-nth 4; a red "!" marks
#             an alertmanager (or a filter using one) whose last refresh failed

if [[ "$1" == "__list-sources" ]]; then
  [[ "$2" == "refresh" ]] && refresh
  jq_alerts '
    . as $alerts
    | def errmark($ids): if any($ids[]; $errs[tostring] != null)
                         then "  \u001b[31m!\u001b[0m" else "" end;
      ($cfg.filters | to_entries[]
        | .key as $i | .value as $f
        | (if ($f.alertmanagers | length) == 0
           then [range($cfg.alertmanagers | length)] else $f.alertmanagers end) as $ids
        | ["filter", $i, $f.name,
           $ifilter + "  " + $f.name + "  " + dim + "(" + ($alerts | alerts_for("filter"; $i) | length | tostring) + ")" + reset + errmark($ids)]),
      ($cfg.alertmanagers | to_entries[]
        | .key as $i | .value as $am
        | ["alertmanager", $i, $am.name,
           $iam + "  " + $am.name + "  " + dim + "(" + ($alerts | alerts_for("alertmanager"; $i) | length | tostring) + ")" + reset + errmark([$i])])
    | @tsv' --arg ifilter "$ICON_FILTER" --arg iam "$ICON_AM"
  exit 0
fi

# ---------- List: alerts for one filter / alertmanager ----------
#
# Called as: fzfalertmanager __list-alerts <filter|alertmanager> <idx> <fingerprint|-> [refresh]
# Emits TAB-separated rows: <alertmanager-idx>\t<fingerprint>\t<display>,
# sorted by severity, then newest first. A fingerprint other than "-" limits
# the list to that single alert (view subcommand).

if [[ "$1" == "__list-alerts" ]]; then
  [[ "$5" == "refresh" ]] && refresh
  jq_alerts '
    alerts_for($type; $idx)
    | if $fp == "-" then . else map(select(.fingerprint == $fp)) end
    | sort_by([sevrank, -((.startsAt | epoch) // 0)])[]
    | secondary as $sum
    | [ (._am | tostring),
        .fingerprint,
        (sevcolor + (severity | rpad(9)) + reset + " " + (.labels.alertname // "unknown")
          + (if $sum != "" then "  " + dim + $sum + reset else "" end)
          + "  " + dim + (.startsAt | ago) + "  " + am.name
          + (if silenced then " [silenced]" else "" end)
          + (if inhibited then " [inhibited]" else "" end)
          + reset) ]
    | @tsv' --arg type "$2" --argjson idx "$3" --arg fp "${4:--}"
  exit 0
fi

# ---------- Preview: filter / alertmanager ----------
#
# Called as: fzfalertmanager __preview-source <filter|alertmanager> <idx>
# Renders the definition, alert counts and last refresh errors of a source.

if [[ "$1" == "__preview-source" ]]; then
  jq_alerts '
    . as $alerts
    | def counts($l):
        "- **Alerts:** \($l | length) (active \($l | map(select(.status.state == "active")) | length), silenced \($l | map(select(silenced)) | length), inhibited \($l | map(select(inhibited)) | length))";
      def errors($ids):
        [$ids[] | select($errs[tostring] != null)
         | "", "### " + $cfg.alertmanagers[.].name, "", "```", ($errs[tostring] | sub("\\s+$"; "")), "```"]
        | if length > 0 then ["", "## Errors"] + . else [] end;
      if $type == "alertmanager" then
        $cfg.alertmanagers[$idx] as $am
        | ["# " + $am.name, "",
           "- **URL:** " + $am.url,
           "- **Type:** " + (if $am.grafana then "Grafana (datasource `\($am.datasource)`)" else "Alertmanager" end),
           "- **Auth:** " + ($am.auth.type // "none")
             + (if $am.grafanaInstance then " (from `GRAFANA_INSTANCES` entry `\($am.grafanaInstance)`)" else "" end),
           counts($alerts | alerts_for("alertmanager"; $idx))]
          + errors([$idx])
      else
        $cfg.filters[$idx] as $f
        | (if ($f.alertmanagers | length) == 0
           then [range($cfg.alertmanagers | length)] else $f.alertmanagers end) as $ids
        | ["# " + $f.name, "",
           counts($alerts | alerts_for("filter"; $idx)),
           "- **Alertmanagers:** " + (if ($f.alertmanagers | length) == 0 then "all"
                                     else [$f.alertmanagers[] | $cfg.alertmanagers[.].name] | join(", ") end),
           "- **States:** " + (if ($f.states | length) == 0 then "all" else $f.states | join(", ") end),
           "- **Receivers:** " + (if ($f.receivers | length) == 0 then "all" else $f.receivers | join(", ") end),
           (if ($f.matchers | length) == 0 then empty
            else "", "## Matchers", "", ($f.matchers[] | "- `\(.k)\(.op)\"\(.v)\"`") end)]
          + errors($ids)
      end
    | join("\n")' --arg type "$2" --argjson idx "$3" | md_render
  exit 0
fi

# ---------- Preview: alert ----------
#
# Called as: fzfalertmanager __preview <alertmanager-idx> <fingerprint>

if [[ "$1" == "__preview" ]]; then
  jq_alerts '.[] | select(._am == $am and .fingerprint == $fp) | markdown' \
    --argjson am "$2" --arg fp "$3" | md_render
  exit 0
fi

# ---------- Actions ----------
#
# Called from the fzf bindings as:
#   fzfalertmanager __action open <source|silence|runbook|dashboard|panel> <alertmanager-idx> <fingerprint>
#   fzfalertmanager __action view <alertmanager-idx> <fingerprint>
#   fzfalertmanager __action yank <alertmanager-idx> <fingerprint>

if [[ "$1" == "__action" ]]; then
  case "$2" in
    open)
      key="$3"
      [[ -z "$4" || -z "$5" ]] && exit 0
      url="$(jq_alerts '.[] | select(._am == $am and .fingerprint == $fp) | link($key)' \
        --argjson am "$4" --arg fp "$5" --arg key "$key")"
      if [[ -z "$url" ]]; then
        pause_msg "No $key link for this alert."
        exit 0
      fi
      open "$url"
      ;;

    view)
      [[ -z "$3" || -z "$4" ]] && exit 0
      out="$FZFALERTMANAGER_DIR/view-$4.md"
      jq_alerts '.[] | select(._am == $am and .fingerprint == $fp) | markdown' \
        --argjson am "$3" --arg fp "$4" > "$out"
      nvim -R "$out"
      ;;

    yank)
      [[ -z "$3" || -z "$4" ]] && exit 0
      url="$(jq_alerts '.[] | select(._am == $am and .fingerprint == $fp) | link("source")' \
        --argjson am "$3" --arg fp "$4")"
      printf '%s' "${url:-$4}" | pbcopy
      ;;

    *)
      exit 1
      ;;
  esac
  exit 0
fi

# ---------- Main mode ----------

usage() {
  cat <<'EOF'
fzfalertmanager - Fuzzy Finder for Alertmanager

Usage:
  fzfalertmanager                                     browse alerts by
                                                      filter / alertmanager
  fzfalertmanager view [alertmanager] [fingerprint]   open a single alert;
                                                      requires the alertmanager
                                                      and fingerprint of the
                                                      alert

Browse the alerts of one or more Alertmanager instances (or Grafana's
Alertmanager proxy). The start screen lists
the configured filters and alertmanagers together; selecting one lists its
alerts with a Markdown preview and deep-link actions. An alertmanager entry
shows all alerts of that instance (including silenced and inhibited ones); a
filter only shows the alerts matching it. A red "!" marks an alertmanager (or a
filter using one) whose last refresh failed; the error is shown in the preview.

Filters & Alertmanagers Keybindings:
  enter  : list the alerts of the selected filter / alertmanager
  ctrl-r : refresh alerts and reload list
  ctrl-p : toggle preview
  ctrl-d : scroll half page down
  ctrl-u : scroll half page up
  alt-h  : show help
  esc    : quit

Alert Keybindings:
  enter  : open the alert markdown in nvim (read-only)
  alt-o  : open the alert source (generatorURL) in the web browser
  alt-s  : open the "create silence" page in the web browser
  alt-r  : open the runbook (runbook_url annotation) in the web browser
  alt-d  : open the Grafana dashboard in the web browser (Grafana only)
  alt-p  : open the Grafana panel in the web browser (Grafana only)
  alt-y  : copy the alert source url (or the fingerprint) to the clipboard
  ctrl-r : refresh alerts and reload list
  ctrl-p : toggle preview
  ctrl-d : scroll half page down
  ctrl-u : scroll half page up
  ctrl-f : scroll preview half page down
  ctrl-b : scroll preview half page up
  home   : scroll preview to top
  end    : scroll preview to bottom
  alt-h  : show help
  esc    : back to the filters / alertmanagers list (quit in the view command)

Environment:
  FZFALERTMANAGER_CONFIG           : JSON config (required)
  FZFALERTMANAGER_REFRESH_INTERVAL : seconds between automatic refreshes of the
                                     alerts list (default: 180)
  GRAFANA_INSTANCES                : Grafana instances referenced via
                                     grafanaInstance
EOF
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

VIEW=0
if [[ "$1" == "view" && $# -eq 3 ]]; then
  VIEW=1
elif [[ $# -gt 0 ]]; then
  echo "Unknown command: $*" >&2
  echo "Usage: fzfalertmanager [view <alertmanager> <fingerprint>]" >&2
  exit 1
fi

for dep in jq fzf curl; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    echo "$dep is required" >&2
    exit 1
  fi
done

umask 077
if ! FZFALERTMANAGER_DIR="$(mktemp -d -t fzfalertmanager)"; then
  echo "Could not create a temp dir" >&2
  exit 1
fi
export FZFALERTMANAGER_DIR
trap 'rm -rf "$FZFALERTMANAGER_DIR"' EXIT
mkdir -p "$FZFALERTMANAGER_DIR/auth" "$FZFALERTMANAGER_DIR/raw" "$FZFALERTMANAGER_DIR/ds"

load_config

# ---------- view: show a single alert ----------
#
# Resolves the alertmanager and checks the alert exists before any fzf UI is
# shown. Only the named alertmanager is resolved and fetched (also on reloads,
# via FZFALERTMANAGER_ONLY), so the credentials of the other instances are not
# touched. The alert list itself is opened below, once run_alerts is defined.

if [[ "$VIEW" == 1 ]]; then
  am_name="$2"
  view_fp="$3"
  view_idx="$(cfg '.alertmanagers | map(.name) | index($n) // empty' --arg n "$am_name")"
  if [[ -z "$view_idx" ]]; then
    echo "No alertmanager named \"$am_name\"" >&2
    exit 1
  fi
  FZFALERTMANAGER_ONLY="$view_idx"
  export FZFALERTMANAGER_ONLY

  resolve_auth "$view_idx"
  refresh
  if [[ -f "$FZFALERTMANAGER_DIR/raw/$view_idx.err" ]]; then
    echo "Could not fetch alerts from $am_name: $(cat "$FZFALERTMANAGER_DIR/raw/$view_idx.err")" >&2
    exit 1
  fi
  if ! jq -e --arg fp "$view_fp" 'any(.[]; .fingerprint == $fp)' \
    "$FZFALERTMANAGER_DIR/alerts.json" >/dev/null; then
    echo "No alert with fingerprint \"$view_fp\" in $am_name" >&2
    exit 1
  fi
else
  resolve_auth
fi

if [[ "$VIEW" == 0 ]]; then
  printf 'Fetching alerts...\n' >&2
  refresh
fi

# List the alerts of one filter / alertmanager, or only the alert with the given
# fingerprint. Returns when the user leaves the list (Esc), so the caller can
# loop back to the source picker.
run_alerts() {
  local type="$1" idx="$2" name="$3" fp="${4:--}" rows
  local ACTION="$SCRIPT __action"
  local LIST="$SCRIPT __list-alerts $type $idx $fp"

  rows="$("$SCRIPT" __list-alerts "$type" "$idx" "$fp")"
  if [[ -z "$rows" ]]; then
    if [[ "$fp" != "-" ]]; then
      pause_msg "Alert $fp not found in $name (resolved?)"
      return 0
    fi
    # Show the source details so a refresh error is not mistaken for "no
    # alerts".
    clear
    "$SCRIPT" __preview-source "$type" "$idx"
    printf '\n'
    pause_msg "No alerts for $name"
    return 0
  fi

  clear
  printf '%s\n' "$rows" | fzf \
    --ansi \
    --delimiter $'\t' \
    --with-nth 3 \
    --reverse \
    --height 100% \
    --info right \
    --track \
    --id-nth 1,2 \
    --prompt "$ICON_ALERT Alerts: " \
    --border rounded \
    --border-label " $ICON_ALERT $name " \
    --border-label-pos center \
    --bind "ctrl-d:half-page-down" \
    --bind "ctrl-u:half-page-up" \
    --bind "alt-h:execute($SCRIPT --help | less -R)" \
    --bind "ctrl-f:preview-half-page-down" \
    --bind "ctrl-b:preview-half-page-up" \
    --bind "home:preview-top" \
    --bind "end:preview-bottom" \
    --bind "ctrl-p:toggle-preview" \
    --bind "ctrl-r:reload-sync($LIST refresh)" \
    --bind "every($FZFALERTMANAGER_REFRESH_INTERVAL):reload-sync($LIST refresh)" \
    --bind "enter:execute($ACTION view {1} {2})" \
    --bind "alt-o:execute($ACTION open source {1} {2})" \
    --bind "alt-s:execute($ACTION open silence {1} {2})" \
    --bind "alt-r:execute($ACTION open runbook {1} {2})" \
    --bind "alt-d:execute($ACTION open dashboard {1} {2})" \
    --bind "alt-p:execute($ACTION open panel {1} {2})" \
    --bind "alt-y:execute($ACTION yank {1} {2})" \
    --preview-window "right:65%" \
    --preview "$SCRIPT __preview {1} {2}"
  return 0
}

# Open the single alert given to the view subcommand; Esc quits.
if [[ "$VIEW" == 1 ]]; then
  run_alerts alertmanager "$view_idx" "$am_name" "$view_fp"
  exit 0
fi

# Combined filters / alertmanagers picker. Selecting an entry drills into its
# alerts; leaving that list returns here (loop) and Esc here quits.
first=1
while true; do
  # Refresh when coming back from an alerts list so the counts are current
  # (the initial refresh already happened above).
  if [[ "$first" == 1 ]]; then
    rows="$("$SCRIPT" __list-sources)"
    first=0
  else
    rows="$("$SCRIPT" __list-sources refresh)"
  fi

  clear
  sel="$(printf '%s\n' "$rows" | fzf \
    --ansi \
    --delimiter $'\t' \
    --with-nth 4 \
    --reverse \
    --height 100% \
    --info right \
    --track \
    --id-nth 1,2 \
    --prompt "$ICON_ALERT Filter / Alertmanager: " \
    --border rounded \
    --border-label " $ICON_ALERT Filters & Alertmanagers " \
    --border-label-pos center \
    --bind "ctrl-d:half-page-down" \
    --bind "ctrl-u:half-page-up" \
    --bind "alt-h:execute($SCRIPT --help | less -R)" \
    --bind "ctrl-p:toggle-preview" \
    --bind "ctrl-r:reload-sync($SCRIPT __list-sources refresh)" \
    --preview-window "right:65%" \
    --preview "$SCRIPT __preview-source {1} {2}")"

  [[ -z "$sel" ]] && exit 0

  sel_type="$(printf '%s' "$sel" | cut -f1)"
  sel_idx="$(printf '%s' "$sel" | cut -f2)"
  sel_name="$(printf '%s' "$sel" | cut -f3)"
  [[ -z "$sel_idx" ]] && continue

  run_alerts "$sel_type" "$sel_idx" "$sel_name"
done
