#!/usr/bin/env zsh

# Source "~/.zprofile" and "~/.zshrc" because by default only "~/.zshenv" is
# sourced.
source ~/.zprofile
source ~/.zshrc

# Open Neovim in Ghostty
# - Set the window title to "Neovim"
# - Resolve the file to an absolute path, because the new Ghostty instance does
#   not inherit the current working directory
# - Escape the file for Neovim
# - Open Neovim with the provided file
if [[ "$1" == "" ]]; then
  open -na ghostty --args --title=Neovim -e zsh -c "nvim"
else
  filename=$(echo "${1:a}" | sed 's/ /\\ /g')
  open -na ghostty --args --title=Neovim -e zsh -c "nvim -c ':e $filename'"
fi

