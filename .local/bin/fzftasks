#!/usr/bin/env bash

# fzftasks - Track work items and the pi agents working on them
#
# Usage: fzftasks [start <key> | open <key> | reply <key> | done <key>... |
#                  reopen <key>... | new [--cwd] | worktrees]
#
# Work items are identified by a key, which encodes the item's kind:
#
#   pr:<owner>/<repo>#<number>      GitHub pull request
#   jira:<KEY>                      Jira work item
#   alert:<alertmanager>:<fp>       Alertmanager alert (name and fingerprint)
#   k8s:<Kind>[.<group>]/[<namespace>/]<name>@<context>
#                                   Kubernetes resource (handed over by fzfk);
#                                   the namespace is omitted for cluster-scoped
#                                   resources, everything after the first "@"
#                                   is the kubeconfig context
#   slack:<channel>/<thread_ts>     Slack thread (handed over by fzfslack; the
#                                   conversation id and the ts of the thread's
#                                   root message)
#   adhoc:<timestamp>-<slug>        ad-hoc task created via "fzftasks new"
#
# Every item maps to exactly one pi session (the session id is derived from the
# key) and one workspace: a git worktree for pull requests and for other items
# with a selected repository, a scratch directory otherwise. Starting an item
# that already exists never creates a new session or workspace; it opens the
# existing one instead. Deleting a done item removes its session and workspace
# (worktrees only without local changes; their branches are kept). Ad-hoc items
# created with "fzftasks new --cwd" use the current directory as an external
# workspace instead, which fzftasks never prepares or removes; their first run
# starts in the current terminal.
#
# "fzftasks worktrees" lists the worktrees in the worktree directory and shows
# which of them are workspaces of items and which were created otherwise
# (manually or by an agent), and deletes the latter.
#
# State is stored in a SQLite database. Items are in one of these states:
#
#   todo     tracked, no run started yet
#   running  pi is running (background or interactive)
#   waiting  pi finished, open the item to continue
#   done     marked as done
#
# Agents started in the background run with "pi -p"; when they finish, the item
# moves to "waiting" and can be opened with an interactive pi on the same
# session, or continued in the background with a reply ("fzftasks reply").
# Failed runs are logged to fzftasks.log in the state directory.

SCRIPT="$(realpath "$0")"

# Directory for the state of fzftasks:
#   fzftasks.db   items (SQLite)
#   fzftasks.log  failed runs
#   sessions/     pi sessions
#   workspaces/   scratch workspaces of items without a repository
#   notify/       notifications of finished background runs, shown by the
#                 picker on its next reload
FZFTASKS_STATE_DIR="${FZFTASKS_STATE_DIR:-$HOME/.local/state/fzftasks}"
# Directory containing the prompt templates ("prompts/*.md"). All templates are
# shown in the prompt picker for every item; the frontmatter "title" (default:
# file name) and "description" are shown in the picker. The placeholders
# {{key}}, {{title}}, {{workspace}}, {{repo}} (empty without repository) and
# {{details}} are replaced.
FZFTASKS_CONFIG_DIR="${FZFTASKS_CONFIG_DIR:-$HOME/.config/fzftasks}"
# Base directory of the local clones ("<dir>/<owner>/<repo>").
FZFTASKS_GITHUB_DIR="${FZFTASKS_GITHUB_DIR:-$HOME/Documents/GitHub}"
# Base directory of the pull request worktrees ("<dir>/<owner>/<repo>/<branch>").
FZFTASKS_WORKTREE_DIR="${FZFTASKS_WORKTREE_DIR:-$HOME/.worktrees}"
# The pi binary.
FZFTASKS_PI="${FZFTASKS_PI:-pi}"
# Seconds between automatic refreshes of the list.
FZFTASKS_REFRESH_INTERVAL="${FZFTASKS_REFRESH_INTERVAL:-10}"

DB="$FZFTASKS_STATE_DIR/fzftasks.db"
LOG="$FZFTASKS_STATE_DIR/fzftasks.log"
SESSIONS="$FZFTASKS_STATE_DIR/sessions"
WORKSPACES="$FZFTASKS_STATE_DIR/workspaces"
# Notifications of finished background runs, one file per item, shown by the
# picker on its next reload.
NOTIFY="$FZFTASKS_STATE_DIR/notify"
PROMPTS="$FZFTASKS_CONFIG_DIR/prompts"

# Bash 5.2+ expands "&" in the replacement of ${var//pattern/replacement} to the
# matched text. Disable it, so "&" in titles and details stays literal.
shopt -u patsub_replacement 2>/dev/null || true

# Nerd font glyphs used in prompts / labels. Defined via byte escapes so they do
# not depend on a bash that supports the \u / \U printf escapes.
ICON_TASKS=$'\xef\x92\xa0'      # tasklist (items)
ICON_PROMPT=$'\xf3\xb1\x99\xba' # robot (prompt for the agent)
ICON_TRASH=$'\xf3\xb0\xa9\xba'  # trash (delete)
ICON_REPO=$'\xef\x90\x81'       # repository
ICON_TREE=$'\xee\x9c\xa5'       # git branch (worktrees)

# ---------- Helpers ----------

die() {
  echo "fzftasks: $*" >&2
  exit 1
}

# Wait for a key press, so messages stay visible when fzftasks runs from an fzf
# binding. Reads from /dev/tty instead of stdin, because stdin may be the pipe
# of the details (fzfgh pipes the PR into "fzftasks start"). Does nothing
# without a terminal.
pause() {
  if (exec </dev/tty) 2>/dev/null; then
    read -n 1 -s -r -p "Press any key to continue..." </dev/tty
    echo
  fi
}

fail() {
  echo "$*"
  pause
  exit 0
}

now() {
  date +%s
}

sql() {
  sqlite3 -batch -separator $'\t' -cmd ".timeout 5000" "$DB" "$@"
}

# Quote a value as an SQL string literal.
q() {
  local sq="'"
  printf "'%s'" "${1//$sq/$sq$sq}"
}

init() {
  mkdir -p "$FZFTASKS_STATE_DIR" "$SESSIONS" "$WORKSPACES" "$NOTIFY" || die "cannot create $FZFTASKS_STATE_DIR"
  sql >/dev/null <<'SQL' || die "cannot initialize $DB"
PRAGMA journal_mode = WAL;
CREATE TABLE IF NOT EXISTS items (
  key        TEXT PRIMARY KEY,
  title      TEXT NOT NULL,
  details    TEXT,
  repo       TEXT,
  workspace  TEXT,
  state      TEXT NOT NULL,
  pid        INTEGER,
  updated_at INTEGER NOT NULL
);
SQL
  # Databases created before the repo column existed. Fails (ignored) when the
  # column is already there.
  sql "ALTER TABLE items ADD COLUMN repo TEXT;" >/dev/null 2>&1 || true
  # 1 when the workspace is an existing directory chosen by the user ("new
  # --cwd"), which is never prepared or removed by fzftasks. Added later, see
  # the repo column.
  sql "ALTER TABLE items ADD COLUMN external_workspace INTEGER;" >/dev/null 2>&1 || true
}

item_field() {
  sql "SELECT $2 FROM items WHERE key = $(q "$1");"
}

kind_of() {
  printf '%s' "${1%%:*}"
}

# Derive the pi session id from a key: "pr:org/repo#123" -> "pr.org.repo.123".
session_id() {
  printf '%s' "$1" | sed -e 's/[:\/#]/./g' -e 's/[^A-Za-z0-9._-]/_/g'
}

# Split a pull request key into PR_REPO ("org/repo") and PR_NUMBER.
parse_pr_key() {
  local rest="${1#pr:}"
  PR_REPO="${rest%%#*}"
  PR_NUMBER="${rest##*#}"
}

# GitHub repository names are case-insensitive, so the same repository can be
# spelled differently by different sources (e.g. "Staffbase/mops" from the
# GitHub API, "staffbase/mops" typed in a URL or as a local directory). All
# repository lookups therefore ignore the case.

# Print the local clone of a repository as "<org>/<repo>" spelled like its
# directory in $FZFTASKS_GITHUB_DIR, preferring an exact match. Returns 1 when
# there is no clone.
local_repo() {
  [[ -n "$1" ]] || return 1
  find "$FZFTASKS_GITHUB_DIR" -mindepth 2 -maxdepth 2 -type d 2>/dev/null |
    awk -v base="$FZFTASKS_GITHUB_DIR/" -v want="$1" '
      { d = substr($0, length(base) + 1) }
      d == want { exact = d }
      tolower(d) == tolower(want) && fold == "" { fold = d }
      END {
        if (exact != "") print exact
        else if (fold != "") print fold
        else exit 1
      }'
}

# Print the key of an existing item, ignoring the case of the repository in
# pull request keys; other keys are printed as they are. New pull request keys
# are spelled like on GitHub when GITHUB is set (needs gh and the network).
resolve_key() {
  local key="$1" existing canonical
  [[ "$(kind_of "$key")" == pr ]] || {
    printf '%s' "$key"
    return
  }
  existing="$(sql "SELECT key FROM items WHERE key = $(q "$key") COLLATE NOCASE ORDER BY key = $(q "$key") DESC LIMIT 1;")"
  if [[ -n "$existing" ]]; then
    printf '%s' "$existing"
    return
  fi
  if [[ -n "${2:-}" ]]; then
    parse_pr_key "$key"
    canonical="$(gh repo view "$PR_REPO" --json nameWithOwner -q .nameWithOwner 2>/dev/null)"
    [[ -n "$canonical" ]] && key="pr:$canonical#$PR_NUMBER"
  fi
  printf '%s' "$key"
}

# Move "running" items whose process is gone (crash, reboot, closed tab) to
# "waiting". Without a key all running items are checked.
reset_stale() {
  local where="state = 'running'" key pid
  [[ -n "$1" ]] && where="$where AND key = $(q "$1")"
  while IFS=$'\t' read -r key pid; do
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
      sql "UPDATE items SET state = 'waiting', pid = NULL, updated_at = $(now) WHERE key = $(q "$key") AND state = 'running';"
      # Remove the item's "working" record from the picker's terminal.
      queue_notification "$key" clear ""
    fi
  done < <(sql "SELECT key, pid FROM items WHERE $where;")
}

# Atomically mark an item as running. Fails when it is already running.
claim() {
  local changed
  changed="$(sql "UPDATE items SET state = 'running', pid = $2, updated_at = $(now) WHERE key = $(q "$1") AND state != 'running'; SELECT changes();")"
  [[ "$changed" == 1 ]]
}

# Render markdown read from stdin with md, falling back to the raw markdown.
md_render() {
  if command -v md >/dev/null 2>&1; then
    MD_WORD_WRAP="${FZF_PREVIEW_COLUMNS:-80}" md
  else
    cat
  fi
}

# Queue a notification for an item: the program status (done, error or clear,
# see status_item) and a message. The picker shows the message via OSC 777 in
# its own Ghostty tab, so clicking the notification focuses fzftasks, and
# reports the status via OSC 7501. Notifications without a message only update
# the status.
queue_notification() {
  local f
  f="$NOTIFY/$(session_id "$1")"
  printf '%s\t%s\t%s' "$2" "$1" "$3" >"$f.tmp" && mv "$f.tmp" "$f"
}

# Show and remove all queued notifications. Writes to /dev/tty, because stdout
# is the list read by fzf.
flush_notifications() {
  local f state key msg
  (exec >/dev/tty) 2>/dev/null || return 0
  for f in "$NOTIFY"/*; do
    [[ -f "$f" && "$f" != *.tmp ]] || continue
    IFS=$'\t' read -r state key msg <"$f"
    rm -f "$f"
    msg="$(printf '%s' "$msg" | tr -d '\000-\037')"
    [[ -n "$msg" ]] && printf '\033]777;notify;fzftasks;%s\007' "$msg" >/dev/tty
    [[ -n "$key" ]] && status_item "$key" "$state" "$msg"
  done
}

# ---------- Program status ----------
#
# The picker reports the agents of the items to its terminal with the Program
# Status Protocol (OSC 7501, see
# https://www.superlogical.com/rex/docs/build/program-status), so terminals like
# Rex can show running and finished runs, e.g. in the session picker and the tab
# header. The root record identifies fzftasks, every item has its own record:
# "working" while pi runs, "done" or "error" when a background run finished
# (until the item is opened, marked as done or deleted). Terminals without
# support ignore the sequences.

# Write a report to the terminal. Does nothing without a terminal.
status_report() {
  (exec >/dev/tty) 2>/dev/null || return 0
  printf '\033]7501;%s\033\\' "$1" >/dev/tty
}

# Encode text as a single-line base64 value without control characters,
# shortened to $2 characters.
status_text() {
  local text
  text="$(printf '%s' "$1" | tr -d '\000-\037\177')"
  printf '%s' "${text:0:$2}" | base64 | tr -d '\n'
}

# Report the status (working, done, error or clear) of an item's record. Record
# ids allow only 32 characters per segment, so the id is a hash of the key.
status_item() {
  local key="$1" state="$2" msg="${3:-}" report
  case "$state" in
    working | done | error | clear) ;;
    *) return 0 ;;
  esac
  report="state=$state:id=$(printf '%s' "$key" | shasum | cut -c1-16)"
  if [[ "$state" != clear ]]; then
    # Titles may have at most 192 bytes, i.e. 48 characters of up to 4 bytes.
    report+=":title=$(status_text "$(item_field "$key" title)" 48)"
    [[ -n "$msg" ]] && report+=":msg=$(status_text "$msg" 200)"
  fi
  status_report "$report"
}

# ---------- Workspaces ----------
#
# prepare_workspace sets WORKSPACE (and BASE, the base branch, for git
# worktrees) and stores the workspace in the database. Problems that do not
# prevent working in the workspace are printed and set WARN.

# Check out a pull request into "$FZFTASKS_WORKTREE_DIR/<org>/<repo>/<branch>".
# An existing worktree is refreshed to the PR's current head, unless it has
# local changes. A fast-forward is tried first; if that fails (e.g. after a
# force-push), the worktree is reset to the new head only when it has no
# unpushed commits (its HEAD and local branch exist on GitHub), so local
# commits of an agent are never discarded.
workspace_pr() {
  local repo_dir clone info head wt old tip
  parse_pr_key "$1"

  if ! clone="$(local_repo "$PR_REPO")"; then
    echo "Local clone of $PR_REPO not found in $FZFTASKS_GITHUB_DIR"
    return 1
  fi
  repo_dir="$FZFTASKS_GITHUB_DIR/$clone"

  info="$(gh pr view "$PR_NUMBER" --repo "$PR_REPO" --json headRefName,baseRefName 2>/dev/null)"
  head="$(jq -r '.headRefName // empty' <<<"$info" 2>/dev/null)"
  BASE="$(jq -r '.baseRefName // empty' <<<"$info" 2>/dev/null)"
  if [[ -z "$head" ]]; then
    echo "Could not determine the head branch of $PR_REPO#$PR_NUMBER"
    return 1
  fi

  # Spelled like the clone, so the worktree path matches the directory on
  # disk.
  wt="$FZFTASKS_WORKTREE_DIR/${clone%%/*}/${clone#*/}/${head//\//-}"
  if [[ ! -d "$wt" ]]; then
    if ! git -C "$repo_dir" worktree add --detach "$wt"; then
      echo "Failed to create worktree at $wt"
      return 1
    fi
    if ! (cd "$wt" && gh pr checkout "$PR_NUMBER" --branch "$head"); then
      git -C "$repo_dir" worktree remove --force "$wt" 2>/dev/null
      echo "Failed to check out $PR_REPO#$PR_NUMBER"
      return 1
    fi
  elif [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]]; then
    echo "Worktree $wt has local changes, not refreshing it"
    WARN=1
  elif ! (cd "$wt" && gh pr checkout "$PR_NUMBER" --branch "$head"); then
    # Not a fast-forward (or a failed fetch): reset only without unpushed work.
    old="$(git -C "$wt" rev-parse HEAD 2>/dev/null)"
    tip="$(git -C "$wt" rev-parse --verify --quiet "refs/heads/$head")"
    if ! commit_on_github "$PR_REPO" "$old" ||
      { [[ -n "$tip" ]] && ! commit_on_github "$PR_REPO" "$tip"; }; then
      echo "Worktree $wt has unpushed commits (or GitHub is unreachable), not refreshing it"
      WARN=1
    elif ! (cd "$wt" && gh pr checkout "$PR_NUMBER" --branch "$head" --force); then
      echo "Failed to refresh $wt, using it as is"
      WARN=1
    else
      echo "Reset $wt from ${old:0:7} to the force-pushed head of $PR_REPO#$PR_NUMBER"
    fi
  fi

  WORKSPACE="$wt"
}

# Succeed if the commit exists on GitHub (in the repository or its fork
# network), i.e. it was pushed and moving a branch away from it loses no work.
commit_on_github() {
  [[ -n "$2" ]] && gh api "repos/$1/commits/$2" --silent >/dev/null 2>&1
}

# Ad-hoc, Jira, alert, Kubernetes and Slack items without a repository work in a
# scratch directory. With a repository they get a worktree at
# "$FZFTASKS_WORKTREE_DIR/<org>/<repo>/<branch>" on a new branch named like the
# session id (e.g. "adhoc.<timestamp>-<slug>", "jira.CORE-123"), created from
# the repository's default branch. An existing worktree is reused as is; it is
# the item's own branch, so there is nothing to refresh.
workspace_task() {
  local repo repo_dir clone branch
  repo="$(item_field "$1" repo)"
  if [[ -z "$repo" ]]; then
    WORKSPACE="$WORKSPACES/$(session_id "$1")"
    mkdir -p "$WORKSPACE"
    return
  fi

  if ! clone="$(local_repo "$repo")"; then
    echo "Local clone of $repo not found in $FZFTASKS_GITHUB_DIR"
    return 1
  fi
  repo_dir="$FZFTASKS_GITHUB_DIR/$clone"

  BASE="$(git -C "$repo_dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
  BASE="${BASE#origin/}"
  if [[ -z "$BASE" ]]; then
    BASE="$(gh repo view "$repo" --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)"
  fi

  branch="$(session_id "$1")"
  WORKSPACE="$FZFTASKS_WORKTREE_DIR/${clone%%/*}/${clone#*/}/$branch"
  [[ -d "$WORKSPACE" ]] && return 0

  if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch"; then
    if ! git -C "$repo_dir" worktree add "$WORKSPACE" "$branch"; then
      echo "Failed to create worktree at $WORKSPACE"
      return 1
    fi
  else
    if [[ -z "$BASE" ]]; then
      echo "Could not determine the default branch of $repo"
      return 1
    fi
    if ! git -C "$repo_dir" fetch origin "$BASE"; then
      echo "Failed to fetch origin/$BASE, using the local state"
      WARN=1
    fi
    # --no-track: the new branch must not use origin/<base> as its upstream,
    # so a plain "git push" never targets the default branch.
    if ! git -C "$repo_dir" worktree add --no-track -b "$branch" "$WORKSPACE" "origin/$BASE"; then
      echo "Failed to create worktree at $WORKSPACE"
      return 1
    fi
  fi
}

prepare_workspace() {
  WORKSPACE=""
  BASE=""
  # External workspaces are used as they are.
  if [[ "$(item_field "$1" external_workspace)" == 1 ]]; then
    WORKSPACE="$(item_field "$1" workspace)"
    if [[ -z "$WORKSPACE" || ! -d "$WORKSPACE" ]]; then
      echo "Workspace not found: $WORKSPACE"
      return 1
    fi
    return 0
  fi
  case "$(kind_of "$1")" in
    pr) workspace_pr "$1" || return 1 ;;
    adhoc | jira | alert | k8s | slack) workspace_task "$1" || return 1 ;;
    *)
      echo "Unsupported item kind: $1"
      return 1
      ;;
  esac
  sql "UPDATE items SET workspace = $(q "$WORKSPACE") WHERE key = $(q "$1");"
}

# ---------- Prompts ----------

# Print a field ("title", "description") from a template's YAML frontmatter.
prompt_field() {
  awk -v field="$2" '
    NR == 1 { if ($0 != "---") exit; fm = 1; next }
    fm && $0 == "---" { exit }
    fm && index($0, field ":") == 1 {
      sub(/^[^:]*:[ \t]*/, "")
      gsub(/^["'\'']|["'\'']$/, "")
      print
      exit
    }
  ' "$1"
}

# Let the user pick one of all prompt templates (every "*.md" in the prompts
# directory) or a built-in entry. Prints the template path ("foreground:<path>"
# when it was picked with alt-enter, to run it in an interactive pi), "open" for
# the "Open" entry, or "track" for the "Track" entry when allowed. Returns 1 when
# cancelled.
choose_prompt() {
  local key="$1" allow_track="$2" rows="" f title out pressed sel path

  # Built-in entries have no template (column 2) but an action (column 3).
  if [[ "$allow_track" == 1 ]]; then
    rows="$(printf '%-30s %s' "Track" "Track as new todo")"$'\t\t'"track"$'\n'
  fi
  rows+="$(printf '%-30s %s' "Open" "Open an interactive pi without a background run")"$'\t\t'"open"$'\n'
  for f in "$PROMPTS"/*.md; do
    [[ -f "$f" ]] || continue
    title="$(prompt_field "$f" title)"
    [[ -n "$title" ]] || title="$(basename "$f" .md)"
    rows+="$(printf '%-30s %s' "$title" "$(prompt_field "$f" description)")"$'\t'"$f"$'\n'
  done
  out="$(printf '%s' "$rows" | fzf \
    --delimiter $'\t' \
    --with-nth 1 \
    --reverse \
    --height 100% \
    --expect alt-enter \
    --prompt "$ICON_PROMPT Prompt: " \
    --border rounded \
    --border-label " $ICON_PROMPT Prompt for $key " \
    --border-label-pos center \
    --bind "ctrl-d:half-page-down" \
    --bind "ctrl-u:half-page-up" \
    --bind "alt-h:execute($SCRIPT --help | less -R)" \
    --preview-window "right:65%" \
    --preview '[ -n {2} ] && cat {2}')" || return 1

  # With --expect the first line is the pressed key (empty for enter).
  pressed="$(sed -n 1p <<<"$out")"
  sel="$(sed -n 2p <<<"$out")"
  path="$(printf '%s' "$sel" | cut -f2)"
  if [[ -z "$path" ]]; then
    printf '%s\n' "$sel" | cut -f3
  elif [[ "$pressed" == alt-enter ]]; then
    printf 'foreground:%s\n' "$path"
  else
    printf '%s\n' "$path"
  fi
}

# Let the user pick a local repository ("$FZFTASKS_GITHUB_DIR/<org>/<repo>") or
# none. Prints "<org>/<repo>", or nothing for "No repository". Returns 1 when
# cancelled.
choose_repo() {
  local rows d sel
  rows="No repository (scratch directory)"$'\t'$'\n'
  while IFS= read -r d; do
    d="${d#"$FZFTASKS_GITHUB_DIR"/}"
    rows+="$d"$'\t'"$d"$'\n'
  done < <(find "$FZFTASKS_GITHUB_DIR" -mindepth 2 -maxdepth 2 -type d 2>/dev/null | sort)

  sel="$(printf '%s' "$rows" | fzf \
    --delimiter $'\t' \
    --with-nth 1 \
    --reverse \
    --height 100% \
    --prompt "$ICON_REPO Repository: " \
    --border rounded \
    --border-label " $ICON_REPO Repository " \
    --border-label-pos center \
    --bind "ctrl-d:half-page-down" \
    --bind "ctrl-u:half-page-up" \
    --bind "alt-h:execute($SCRIPT --help | less -R)")" || return 1

  printf '%s' "$sel" | cut -f2
}

# Render a template: strip the frontmatter and replace the placeholders.
render_prompt() {
  local body p
  body="$(awk 'NR == 1 && $0 == "---" { fm = 1; next } fm && $0 == "---" { fm = 0; next } !fm' "$1")"
  p='{{key}}'
  body=${body//"$p"/$2}
  p='{{title}}'
  body=${body//"$p"/$3}
  p='{{workspace}}'
  body=${body//"$p"/$4}
  p='{{repo}}'
  body=${body//"$p"/$6}
  p='{{details}}'
  body=${body//"$p"/$5}
  printf '%s\n' "$body"
}

# ---------- Commands ----------

cmd_start() {
  local key="" title="" repo="" repo_given=0 details_stdin=0 cwd="" kind state tmp tpl
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cwd) cwd="$PWD"; shift ;;
      --title=*) title="${1#*=}"; shift ;;
      --title) title="$2"; shift 2 ;;
      --repo=*) repo="${1#*=}"; repo_given=1; shift ;;
      --repo) repo="$2"; repo_given=1; shift 2 ;;
      --details=-) details_stdin=1; shift ;;
      --details)
        [[ "$2" == "-" ]] || die "start: --details only supports '-' (stdin)"
        details_stdin=1
        shift 2
        ;;
      -*) die "start: unknown flag: $1" ;;
      *) key="$1"; shift ;;
    esac
  done
  [[ -n "$key" ]] || die "start: missing key"

  kind="$(kind_of "$key")"
  case "$kind" in
    pr | adhoc | jira | alert | k8s | slack) ;;
    *) fail "Unsupported item kind: $key" ;;
  esac

  init
  # The same pull request may be handed over with a differently spelled
  # repository; reuse its item, and spell new keys like on GitHub.
  key="$(resolve_key "$key" github)"
  reset_stale "$key"
  state="$(item_field "$key" state)"

  case "$state" in
    running) fail "$key is already running" ;;
    waiting | done)
      cmd_open "$key"
      return
      ;;
    todo)
      tpl="$(choose_prompt "$key" 0)" || return 0
      if [[ "$tpl" == open ]]; then
        cmd_open "$key"
        return
      fi
      ;;
    "")
      [[ -n "$title" ]] || die "start: --title is required for new items"
      tmp="$(mktemp "${TMPDIR:-/tmp}/fzftasks.XXXXXX")"
      [[ "$details_stdin" == 1 ]] && cat >"$tmp"
      # With --cwd the current directory is the workspace: no repository and
      # no prompt, the item's interactive pi starts in the current terminal.
      # Background runs are not offered, because the prompts assume a workspace
      # prepared for the item.
      if [[ -n "$cwd" ]]; then
        [[ "$kind" == adhoc ]] || die "start: --cwd is only supported for ad-hoc items"
        title="$(printf '%s' "$title" | tr '\t\n' '  ')"
        sql "INSERT INTO items (key, title, details, workspace, external_workspace, state, updated_at) VALUES ($(q "$key"), $(q "$title"), CAST(readfile($(q "$tmp")) AS TEXT), $(q "$cwd"), 1, 'todo', $(now));"
        rm -f "$tmp"
        # stdin may be the (drained) details pipe of "new --cwd"; pi needs the
        # terminal, otherwise it falls back to print mode and exits at once.
        exec "$SCRIPT" __run "$key" </dev/tty
      fi
      # Ad-hoc, Jira, alert, Kubernetes and Slack items can work in a
      # repository; ask for it unless the caller passed --repo (an empty value
      # means "no repository").
      if [[ "$repo_given" == 0 && "$kind" != pr ]]; then
        if ! repo="$(choose_repo)"; then
          rm -f "$tmp"
          return 0
        fi
      fi
      if ! tpl="$(choose_prompt "$key" 1)"; then
        rm -f "$tmp"
        return 0
      fi
      title="$(printf '%s' "$title" | tr '\t\n' '  ')"
      # Pull requests work in their own repository, spelled like in the key.
      if [[ "$kind" == pr ]]; then
        parse_pr_key "$key"
        repo="$PR_REPO"
      fi
      sql "INSERT INTO items (key, title, details, repo, state, updated_at) VALUES ($(q "$key"), $(q "$title"), CAST(readfile($(q "$tmp")) AS TEXT), NULLIF($(q "$repo"), ''), 'todo', $(now));"
      rm -f "$tmp"
      if [[ "$tpl" == track ]]; then
        echo "Tracking $key"
        return 0
      fi
      if [[ "$tpl" == open ]]; then
        cmd_open "$key"
        return
      fi
      ;;
  esac

  # A template picked with alt-enter runs in an interactive pi.
  if [[ "$tpl" == foreground:* ]]; then
    cmd_open "$key" "${tpl#foreground:}"
    return
  fi

  start_run "$key" "$tpl"
}

# Start a background run of a "todo" item with the given prompt template.
start_run() {
  local key="$1" tpl="$2" prompt_file
  WARN=""

  claim "$key" "$$" || fail "$key is already running"
  if ! prepare_workspace "$key"; then
    sql "UPDATE items SET state = 'todo', pid = NULL, updated_at = $(now) WHERE key = $(q "$key");"
    fail "Failed to prepare the workspace for $key"
  fi

  prompt_file="$(mktemp "${TMPDIR:-/tmp}/fzftasks-prompt.XXXXXX")"
  render_prompt "$tpl" "$key" "$(item_field "$key" title)" "$WORKSPACE" "$(item_field "$key" details)" "$(item_field "$key" repo)" >"$prompt_file"

  launch_run "$key" "$prompt_file"

  echo "Started $key"
  [[ -n "$WARN" ]] && pause
  return 0
}

# Succeed if fzftasks runs in a Rex terminal, which sets TERM_PROGRAM and
# REX_BLOCK and puts the rex CLI on the PATH.
in_rex() {
  [[ "${TERM_PROGRAM:-}" == rex && -n "${REX_BLOCK:-}" ]] && command -v rex >/dev/null 2>&1
}

# Type a command into the shell of a Rex block and run it. Like ghostty-new, the
# command is typed instead of passed to "rex new" / "rex split", so it runs in
# the interactive shell with its configuration (e.g. the PATH from ~/.zshrc).
rex_type_command() {
  printf '%s' "$3" | rex send -s "$1" -b "$2" && rex send-key -s "$1" -b "$2" enter
}

# Open the item's layout in a new Rex session labelled LABEL: a terminal in the
# workspace running CMD and, if SPLIT_CMD is given, a split on the right running
# SPLIT_CMD. With SIDEBAR set, the Rex sidebar (sidebar_toggle action in
# ~/.config/rex/init.lua) is shown for the workspace. Afterwards the Rex app
# switches to the session, which requires "Remote Control" in the Rex settings;
# without it, a message is shown instead.
open_rex() {
  local label="$1" cmd="$2" split_cmd="$3" sidebar="$4" out session block
  out="$(rex new "$label" -c "$WORKSPACE" --json)" || return 1
  session="$(jq -r '.session_id // empty' <<<"$out")"
  block="$(jq -r '.initial_windows[0].block_ids[0] // empty' <<<"$out")"
  [[ -n "$session" && -n "$block" ]] || return 1
  rex_type_command "$session" "$block" "$cmd" || return 1

  if [[ -n "$split_cmd" ]]; then
    out="$(rex split -s "$session" -b "$block" --split=right -c "$WORKSPACE" --json)" || return 1
    block="$(jq -r '.block_ids[0] // empty' <<<"$out")"
    [[ -n "$block" ]] || return 1
    rex_type_command "$session" "$block" "$split_cmd" || return 1
  fi

  if ! rex do session.select session_id="$session" >/dev/null 2>&1; then
    echo "Opened the Rex session \"$label\", but could not switch to it"
    echo "(turn on \"Remote Control\" in the Rex settings under \"Server > Client Info\")"
    pause
  fi

  # The sidebar is opened once the session is shown, so that it gets its width
  # from the real size of the window. Errors are ignored, e.g. when the Rex
  # configuration has no sidebar.
  if [[ -n "$sidebar" ]]; then
    sleep 0.5
    rex do -s "$session" -b "$block" sidebar_toggle dir="$WORKSPACE" >/dev/null 2>&1 || true
  fi
}

# Open the item's layout: for items with a repository (pull requests and other
# items with a selected repository) nvim showing the diff against the base
# branch and a split with an interactive pi; otherwise only pi. In Rex the
# layout is opened in a new session, otherwise in a new Ghostty tab. With a
# prompt template TPL, the rendered prompt is sent as the first message of the
# interactive pi (a foreground run).
cmd_open() {
  local key="$1" tpl="$2" state title repo run_cmd nvim_cmd tab_title prompt_file
  [[ -n "$key" ]] || die "open: missing key"
  WARN=""

  init
  key="$(resolve_key "$key")"
  reset_stale "$key"
  state="$(item_field "$key" state)"
  [[ -n "$state" ]] || fail "Unknown item: $key"
  [[ "$state" == running ]] && fail "$key is already running"

  prepare_workspace "$key" || fail "Failed to prepare the workspace for $key"
  [[ -n "$WARN" ]] && pause

  title="$(item_field "$key" title)"
  repo="$(item_field "$key" repo)"
  run_cmd="$(printf '%q ' "$SCRIPT" __run "$key")"
  if [[ -n "$tpl" ]]; then
    prompt_file="$(mktemp "${TMPDIR:-/tmp}/fzftasks-prompt.XXXXXX")"
    render_prompt "$tpl" "$key" "$title" "$WORKSPACE" "$(item_field "$key" details)" "$repo" >"$prompt_file"
    run_cmd="$(printf '%q ' "$SCRIPT" __run "$key" --message-file "$prompt_file")"
  fi

  if [[ "$(kind_of "$key")" == pr ]]; then
    parse_pr_key "$key"
    tab_title="$PR_REPO#$PR_NUMBER: $title"
  elif [[ "$(kind_of "$key")" == jira ]]; then
    tab_title="${key#jira:}: $title"
  elif [[ -n "$repo" ]]; then
    tab_title="$repo: $title"
  else
    tab_title="$title"
  fi

  if [[ -z "$repo" ]]; then
    if in_rex; then
      open_rex "$tab_title" "$run_cmd" || fail "Failed to open a new Rex session"
    else
      ghostty-new --working-dir "$WORKSPACE" --title "$tab_title" --command "$run_cmd" ||
        fail "Failed to open a new Ghostty tab"
    fi
    return
  fi

  nvim_cmd="nvim -c GitDiff"
  if [[ -n "$BASE" ]] && git -C "$WORKSPACE" fetch origin "$BASE" >/dev/null 2>&1; then
    nvim_cmd="nvim -c \"GitDiff HEAD origin/$BASE\""
  fi
  if in_rex; then
    open_rex "$tab_title" "$nvim_cmd" "$run_cmd" sidebar || fail "Failed to open a new Rex session"
    return
  fi
  ghostty-new --working-dir "$WORKSPACE" --title "$tab_title" --command "$nvim_cmd" ||
    fail "Failed to open a new Ghostty tab"
  ghostty-new --placement split --direction right --working-dir "$WORKSPACE" --command "$run_cmd" ||
    fail "Failed to open a new Ghostty split"
}

# Build an SQL list of string literals from the arguments: "('a', 'b')".
sql_list() {
  local list="" k
  for k in "$@"; do
    list+="${list:+, }$(q "$k")"
  done
  printf '(%s)' "$list"
}

cmd_done() {
  local k keys=()
  [[ $# -gt 0 && -n "$1" ]] || die "done: missing key"
  init
  for k in "$@"; do
    keys+=("$(resolve_key "$k")")
  done
  sql "UPDATE items SET state = 'done', updated_at = $(now) WHERE key IN $(sql_list "${keys[@]}");"
  for k in "${keys[@]}"; do
    status_item "$k" clear
  done
}

# Move done items back to waiting. Other states are left unchanged.
cmd_reopen() {
  local k keys=()
  [[ $# -gt 0 && -n "$1" ]] || die "reopen: missing key"
  init
  for k in "$@"; do
    keys+=("$(resolve_key "$k")")
  done
  sql "UPDATE items SET state = 'waiting', updated_at = $(now) WHERE key IN $(sql_list "${keys[@]}") AND state = 'done';"
}

# Create an ad-hoc item in $EDITOR: the first non-empty line is the title, the
# rest the details. An empty file cancels. Afterwards a repository can be
# selected, in which the item gets its own worktree. With --cwd the current
# directory is used as the workspace and the item's pi starts in the current
# terminal.
cmd_new() {
  local tmp title details slug key repo cwd=()
  case "$1" in
    "") ;;
    --cwd) cwd=(--cwd) ;;
    *) die "new: unknown flag: $1" ;;
  esac
  tmp="$(mktemp "${TMPDIR:-/tmp}/fzftasks-new.XXXXXX")" || die "cannot create a temporary file"
  mv "$tmp" "$tmp.md" && tmp="$tmp.md"
  "${EDITOR:-nvim}" "$tmp"

  title="$(awk 'NF { print; exit }' "$tmp")"
  details="$(awk 'found { print; next } NF { found = 1 }' "$tmp")"
  rm -f "$tmp"
  [[ -n "$title" ]] || return 0

  slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' | cut -c1-40 | sed 's/-*$//')"
  key="adhoc:$(date +%Y%m%d-%H%M%S)${slug:+-$slug}"
  printf '%s\n' "$details" | cmd_start "$key" --title "$title" --details - "${cwd[@]}"
}

# Start a background run of an item claimed by this process with the given
# prompt file, which the run removes when it finishes.
launch_run() {
  local pid
  nohup "$SCRIPT" __run "$1" --prompt-file "$2" >/dev/null 2>&1 </dev/null &
  pid=$!
  sql "UPDATE items SET pid = $pid WHERE key = $(q "$1") AND state = 'running' AND pid = $$;"
}

# Continue a waiting item in the background: the reply is written in $EDITOR
# (an empty reply cancels) and sent to the item's session with "pi -p".
cmd_reply() {
  local key="$1" workspace tmp prompt_file changed
  [[ -n "$key" ]] || die "reply: missing key"

  init
  key="$(resolve_key "$key")"
  reset_stale "$key"
  [[ "$(item_field "$key" state)" == waiting ]] ||
    fail "Only waiting items can be continued in the background"
  workspace="$(item_field "$key" workspace)"
  [[ -n "$workspace" && -d "$workspace" ]] ||
    fail "Workspace of $key not found, open the item instead"

  tmp="$(mktemp "${TMPDIR:-/tmp}/fzftasks-reply.XXXXXX")" || die "cannot create a temporary file"
  mv "$tmp" "$tmp.md" && tmp="$tmp.md"
  "${EDITOR:-nvim}" "$tmp"
  if ! grep -q '[^[:space:]]' "$tmp"; then
    rm -f "$tmp"
    return 0
  fi

  prompt_file="$(mktemp "${TMPDIR:-/tmp}/fzftasks-prompt.XXXXXX")"
  {
    cat "$tmp"
    printf '\n%s\n' "(You are still running unattended, nobody is watching this session. Stop again at the FIRST point where you would ask the user anything and state the exact question.)"
  } >"$prompt_file"
  rm -f "$tmp"

  # Claim only while still waiting: the item may have been opened or marked as
  # done while the reply was written.
  changed="$(sql "UPDATE items SET state = 'running', pid = $$, updated_at = $(now) WHERE key = $(q "$key") AND state = 'waiting'; SELECT changes();")"
  if [[ "$changed" != 1 ]]; then
    rm -f "$prompt_file"
    fail "$key is no longer waiting, the reply was not sent"
  fi
  launch_run "$key" "$prompt_file"
  echo "Continued $key"
}

# Run pi for an item and track its state. With --prompt-file the run is a
# background run started (and already claimed) by "start" or "reply"; otherwise an
# interactive pi is started on the item's session, with --message-file sending
# the file's content as the first message (a foreground run).
cmd_run() {
  local key="$1" prompt_file="" message_file="" message=() prev workspace sid rc errf="" new
  [[ "$2" == "--prompt-file" ]] && prompt_file="$3"
  if [[ "$2" == "--message-file" ]]; then
    message_file="$3"
    [[ -f "$message_file" ]] && message=(-- "$(cat "$message_file")")
    rm -f "$message_file"
  fi
  [[ -n "$key" ]] || die "__run: missing key"

  init
  if [[ -n "$prompt_file" ]]; then
    prev="todo"
    sql "UPDATE items SET pid = $$ WHERE key = $(q "$key") AND state = 'running';"
  else
    reset_stale "$key"
    prev="$(item_field "$key" state)"
    [[ -n "$prev" ]] || fail "Unknown item: $key"
    claim "$key" "$$" || fail "$key is already running"
  fi

  workspace="$(item_field "$key" workspace)"
  sid="$(session_id "$key")"
  local args=(--session-dir "$SESSIONS" --session-id "$sid")

  if [[ -z "$workspace" ]] || ! cd "$workspace"; then
    rc=1
    printf '%s %s exit=%s workspace not found: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$key" "$rc" "$workspace" >>"$LOG"
  elif [[ -n "$prompt_file" ]]; then
    errf="$(mktemp "${TMPDIR:-/tmp}/fzftasks-err.XXXXXX")"
    "$FZFTASKS_PI" "${args[@]}" -p <"$prompt_file" >/dev/null 2>"$errf"
    rc=$?
  else
    "$FZFTASKS_PI" "${args[@]}" "${message[@]}"
    rc=$?
  fi

  if [[ "$rc" != 0 && -n "$workspace" && -d "$workspace" ]]; then
    {
      printf '%s %s exit=%s' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$key" "$rc"
      [[ -s "$errf" ]] && printf ' %s' "$(tr '\n' ' ' <"$errf")"
      printf '\n'
    } >>"$LOG"
  fi

  new="waiting"
  [[ "$prev" == done ]] && new="done"
  sql "UPDATE items SET state = $(q "$new"), pid = NULL, updated_at = $(now) WHERE key = $(q "$key") AND state = 'running';"
  rm -f "$prompt_file" "$errf"

  if [[ -n "$prompt_file" ]]; then
    if [[ "$rc" == 0 ]]; then
      queue_notification "$key" done "Finished: $(item_field "$key" title)"
    else
      queue_notification "$key" error "Failed (exit $rc): $(item_field "$key" title)"
    fi
  else
    # Interactive runs are reported by pi itself in their own terminal; only
    # remove the item's "working" record from the picker's terminal.
    queue_notification "$key" clear ""
  fi
}

age() {
  local s="$1"
  if ((s < 60)); then
    echo "${s}s"
  elif ((s < 3600)); then
    echo "$((s / 60))m"
  elif ((s < 86400)); then
    echo "$((s / 3600))h"
  else
    echo "$((s / 86400))d"
  fi
}

cmd_list() {
  local ts key state title updated icon kind
  init
  reset_stale
  ts="$(now)"
  sql "SELECT key, state, title, updated_at FROM items ORDER BY CASE state WHEN 'running' THEN 0 WHEN 'waiting' THEN 1 WHEN 'todo' THEN 2 ELSE 3 END, updated_at DESC;" |
    while IFS=$'\t' read -r key state title updated; do
      case "$state" in
        running) icon=$'\033[33m◐' ;;
        waiting) icon=$'\033[35m●' ;;
        todo) icon=$'\033[37m○' ;;
        *) icon=$'\033[32m✓' ;;
      esac
      kind="$(kind_of "$key")"
      printf '%s\t%s %-7s\033[0m \033[36m%-5s\033[0m %s \033[90m%s\033[0m\n' \
        "$key" "$icon" "$state" "$kind" "$title" "$(age $((ts - updated)))"
    done
  # Report all running items as "working". Finished runs are reported by the
  # notifications afterwards.
  while IFS= read -r key; do
    status_item "$key" working "Running pi"
  done < <(sql "SELECT key FROM items WHERE state = 'running';")
  flush_notifications
}

# Print the transcript of a session as markdown: the user and agent messages
# in file order, without tool calls, tool results, thinking and compactions.
transcript() {
  jq -rs '
    [ .[]
      | select(.type == "message") | .message
      | select(.role == "user" or .role == "assistant")
      | { role,
          text: (if (.content | type) == "string" then .content
                 else [ .content[]? | select(.type == "text") | .text ] | join("\n") end) }
      | select(.text | test("\\S"))
      | (if .role == "user" then "# User" else "# Agent" end) + "\n\n" + .text ]
    | join("\n\n")' "$1" 2>/dev/null
}

# Print the fzf actions switching the preview between the summary and the
# transcript, based on the current preview label.
cmd_preview_toggle() {
  if [[ "${FZF_PREVIEW_LABEL:-}" == *Transcript* ]]; then
    printf 'change-preview(%s __preview {1})+change-preview-label()+change-preview-window(nofollow)' "$SCRIPT"
  else
    printf 'change-preview(%s __preview --transcript {1})+change-preview-label( Transcript )+change-preview-window(follow)' "$SCRIPT"
  fi
}

cmd_preview() {
  local key mode=summary sid session msg details workspace repo
  if [[ "$1" == --transcript ]]; then
    mode=transcript
    shift
  fi
  key="$1"
  [[ -n "$key" ]] || exit 0
  init
  sid="$(session_id "$key")"
  session="$(find "$SESSIONS" -type f -name "*_${sid}.jsonl" 2>/dev/null | sort | tail -n 1)"

  if [[ "$mode" == transcript ]]; then
    [[ -n "$session" ]] && msg="$(transcript "$session")"
    printf '%s\n' "${msg:-No session yet.}" | md_render
    return
  fi

  if [[ -n "$session" ]]; then
    msg="$(jq -rs '
      [ .[]
        | select(.type == "message" and .message.role == "assistant")
        | [ .message.content[]? | select(.type == "text") | .text ] | join("\n")
        | select(length > 0) ]
      | last // empty' "$session" 2>/dev/null)"
  fi

  {
    printf '# %s\n\n' "$(item_field "$key" title)"
    printf -- '- **Key:** `%s`\n' "$key"
    printf -- '- **State:** %s\n' "$(item_field "$key" state)"
    repo="$(item_field "$key" repo)"
    printf -- '- **Repository:** %s\n' "$repo"
    workspace="$(item_field "$key" workspace)"
    if [[ -n "$workspace" ]]; then
      printf -- '- **Workspace:** `%s`\n\n' "$workspace"
    else
      printf -- '- **Workspace:**\n\n'
    fi
    [[ -n "$msg" ]] && printf '# Agent\n\n%s\n\n' "$msg"
    details="$(item_field "$key" details)"
    [[ -n "$details" ]] && printf '# Description\n\n%s\n' "$details"
  } | md_render
}

# Delete a done item, its session and workspace. Prints the reason and returns
# 1 when the item is kept.
delete_item() {
  local key="$1" workspace repo
  if [[ "$(item_field "$key" state)" != done ]]; then
    echo "$key is not done, mark it as done first (alt-d)"
    return 1
  fi

  # Remove the workspace: scratch directories are deleted, worktrees are
  # removed without --force (refuses on local changes). The branch is kept.
  # The item is only deleted when the workspace is gone, so it can be retried.
  # External workspaces ("new --cwd") are never removed.
  workspace="$(item_field "$key" workspace)"
  if [[ "$(item_field "$key" external_workspace)" == 1 ]]; then
    :
  elif [[ -n "$workspace" && -d "$workspace" ]]; then
    if [[ "$workspace" == "$WORKSPACES"/* ]]; then
      rm -rf "$workspace"
    else
      if [[ "$(kind_of "$key")" == pr ]]; then
        parse_pr_key "$key"
        repo="$PR_REPO"
      else
        repo="$(item_field "$key" repo)"
      fi
      repo="$(local_repo "$repo")" || repo=""
      if [[ -z "$repo" ]] || ! git -C "$FZFTASKS_GITHUB_DIR/$repo" worktree remove "$workspace"; then
        echo "Failed to remove the worktree $workspace (local changes?), $key is kept"
        return 1
      fi
    fi
  fi
  find "$SESSIONS" -type f -name "*_$(session_id "$key").jsonl" -delete
  rm -f "$NOTIFY/$(session_id "$key")"
  status_item "$key" clear
  sql "DELETE FROM items WHERE key = $(q "$key");"
}

cmd_action() {
  local action="$1" key="$2" answer rest label ref ctx a b c k failed=0
  [[ -n "$key" ]] || exit 0
  init

  case "$action" in
    view)
      case "$(kind_of "$key")" in
        pr)
          parse_pr_key "$key"
          fzfgh view "https://github.com/$PR_REPO/pull/$PR_NUMBER"
          ;;
        jira)
          fzfjira "key = ${key#jira:}"
          ;;
        alert)
          rest="${key#alert:}"
          fzfalertmanager view "${rest%:*}" "${rest##*:}"
          ;;
        k8s)
          # "<Kind>[.<group>]/[<namespace>/]<name>@<context>": kind, namespace
          # and name never contain "@" or "/", so the context is everything
          # after the first "@". Opens fzfk on the single object (field
          # selector on the name), with the kind lowercased as kubectl expects
          # it in resource arguments ("deployment.apps"). Uses the default
          # kubeconfig.
          rest="${key#k8s:}"
          ref="${rest%%@*}"
          ctx="${rest#*@}"
          IFS=/ read -r a b c <<<"$ref"
          a="$(printf '%s' "$a" | tr '[:upper:]' '[:lower:]')"
          if [[ -n "$c" ]]; then
            fzfk "$a" --context "$ctx" -n "$b" --field-selector "metadata.name=$c"
          else
            fzfk "$a" --context "$ctx" --field-selector "metadata.name=$b"
          fi
          ;;
        slack)
          # "<channel>/<thread_ts>": opens the thread in fzfslack's message
          # view.
          rest="${key#slack:}"
          fzfslack thread view "${rest%%/*}" "${rest#*/}"
          ;;
        *)
          # Ad-hoc items have no source; their details are in the preview.
          ;;
      esac
      ;;

    delete)
      # All selected items (or the current one): "__action delete <key>...".
      shift
      for k in "$@"; do
        [[ "$(item_field "$k" state)" == done ]] ||
          fail "Only done items can be deleted, mark $k as done first (alt-d)"
      done
      if [[ $# -eq 1 ]]; then
        label="$(item_field "$key" title)"
      else
        label="$# items"
      fi
      answer="$(printf '%s\n' "No" "Yes" | fzf \
        --bind "ctrl-d:half-page-down" \
        --bind "ctrl-u:half-page-up" \
        --bind "alt-h:execute($SCRIPT --help | less -R)" \
        --prompt "$ICON_TRASH Delete $label: " \
        --height 100% \
        --reverse \
        --border rounded \
        --border-label " $ICON_TRASH Delete $label " \
        --border-label-pos center)"
      [[ "$answer" != "Yes" ]] && exit 0

      # Items whose workspace cannot be removed are kept; the others are
      # still deleted.
      for k in "$@"; do
        delete_item "$k" || failed=1
      done
      [[ "$failed" == 1 ]] && pause
      ;;
  esac
}

# ---------- Worktrees ----------

# Worktrees in $FZFTASKS_WORKTREE_DIR ("<dir>/<owner>/<repo>/<branch>") are
# either the workspace of an item (removed when the item is deleted) or "other"
# worktrees, created manually or by an agent in addition to the item's
# workspace. Only other worktrees can be deleted in the worktree picker.

# Print an identifier of a directory ("<device>:<inode>"). Workspaces are
# matched by it instead of by path, because the stored path can be spelled
# differently than the directory found on disk: the owner of a PR key is
# spelled like on GitHub (e.g. "Staffbase"), while the directory may be
# lowercase on a case-insensitive file system. Tries GNU stat first, because
# "stat -f" means something else there.
path_id() {
  stat -c '%d:%i' "$1" 2>/dev/null || stat -f '%d:%i' "$1" 2>/dev/null
}

# Print the workspaces of items as "<path id>\t<key>\t<state>". Workspaces that
# no longer exist are skipped. External workspaces ("new --cwd") are never
# removed by fzftasks, so they do not own a worktree.
item_workspaces() {
  local workspace key state id
  while IFS=$'\t' read -r workspace key state; do
    id="$(path_id "$workspace")" && printf '%s\t%s\t%s\n' "$id" "$key" "$state"
  done < <(sql "SELECT workspace, key, state FROM items WHERE COALESCE(workspace, '') != '' AND COALESCE(external_workspace, 0) != 1;")
}

# Print the item owning the worktree as "<key>\t<state>", nothing for other
# worktrees.
worktree_owner() {
  local id wid key state
  id="$(path_id "$1")" || return 0
  while IFS=$'\t' read -r wid key state; do
    if [[ "$wid" == "$id" ]]; then
      printf '%s\t%s\n' "$key" "$state"
      return 0
    fi
  done < <(item_workspaces)
}

# Print the state of a worktree: "clean" or the number of changed files and of
# commits that are on no remote (unpushed).
worktree_changes() {
  local changed unpushed out=""
  changed="$(git -C "$1" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  unpushed="$(git -C "$1" rev-list --count HEAD --not --remotes 2>/dev/null)"
  [[ "${changed:-0}" != 0 ]] && out="$changed changed"
  [[ "${unpushed:-0}" != 0 ]] && out="${out:+$out, }$unpushed unpushed"
  echo "${out:-clean}"
}

# List the worktrees as "<path>\t<line>", other worktrees first.
cmd_worktrees_list() {
  local gitfile wt id rel owner key state branch changes width=0 cwidth=0 i j pass color
  local item_ids=() item_owners=()
  local paths=() rels=() keys=() states=() branches=() changes_list=()
  init
  [[ -d "$FZFTASKS_WORKTREE_DIR" ]] || return 0

  while IFS=$'\t' read -r id key state; do
    item_ids+=("$id") item_owners+=("$key"$'\t'"$state")
  done < <(item_workspaces)

  while IFS= read -r gitfile; do
    wt="${gitfile%/.git}"
    owner=""
    if id="$(path_id "$wt")"; then
      for j in "${!item_ids[@]}"; do
        [[ "${item_ids[j]}" == "$id" ]] && owner="${item_owners[j]}" && break
      done
    fi
    IFS=$'\t' read -r key state <<<"$owner"
    rel="${wt#"$FZFTASKS_WORKTREE_DIR"/}"
    branch="$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "(detached)")"
    changes="$(worktree_changes "$wt")"
    paths+=("$wt") rels+=("$rel") keys+=("$key") states+=("$state")
    branches+=("$branch") changes_list+=("$changes")
    ((${#rel} > width)) && width=${#rel}
    ((${#changes} > cwidth)) && cwidth=${#changes}
  done < <(find "$FZFTASKS_WORKTREE_DIR" -mindepth 4 -maxdepth 4 -name .git 2>/dev/null | sort)

  # Other worktrees first, then the workspaces of items. The branch is only
  # shown when it differs from the directory name.
  for pass in other item; do
    for i in "${!paths[@]}"; do
      [[ "$pass" == other && -n "${keys[i]}" ]] && continue
      [[ "$pass" == item && -z "${keys[i]}" ]] && continue
      color=$'\033[90m'
      [[ "${changes_list[i]}" != clean ]] && color=$'\033[31m'
      branch="${branches[i]}"
      [[ "${branch//\//-}" == "${rels[i]##*/}" ]] && branch=""
      if [[ -z "${keys[i]}" ]]; then
        printf '%s\t\033[33m○ other\033[0m %s%-*s\033[0m %-*s \033[90m%s\033[0m\n' \
          "${paths[i]}" "$color" "$cwidth" "${changes_list[i]}" "$width" "${rels[i]}" "$branch"
      else
        printf '%s\t\033[32m● item \033[0m %s%-*s\033[0m %-*s \033[36m%s\033[0m \033[90m%s %s\033[0m\n' \
          "${paths[i]}" "$color" "$cwidth" "${changes_list[i]}" "$width" "${rels[i]}" "${keys[i]}" "${states[i]}" "$branch"
      fi
    done
  done
}

cmd_worktrees_preview() {
  local wt="$1" key state common unpushed
  [[ -n "$wt" ]] || return 0
  init
  IFS=$'\t' read -r key state < <(worktree_owner "$wt")
  common="$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  printf '\033[1mPath:\033[0m       %s\n' "$wt"
  printf '\033[1mRepository:\033[0m %s\n' "${common%/.git}"
  printf '\033[1mBranch:\033[0m     %s\n' "$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "(detached)")"
  if [[ -n "$key" ]]; then
    printf '\033[1mItem:\033[0m       \033[36m%s\033[0m (%s), removed when the item is deleted\n' "$key" "$state"
  else
    printf '\033[1mItem:\033[0m       \033[33mnone\033[0m, not created by fzftasks\n'
  fi
  printf '\n\033[1mChanges\033[0m\n\n'
  git -C "$wt" -c color.status=always status --short 2>&1
  printf '\n\033[1mUnpushed commits\033[0m\n\n'
  unpushed="$(git -C "$wt" log --color=always --oneline -n 20 HEAD --not --remotes 2>&1)"
  printf '%s\n' "${unpushed:-none}"
  printf '\n\033[1mRecent commits\033[0m\n\n'
  git -C "$wt" log --color=always --oneline -n 10 2>&1
}

# Delete other worktrees: "git worktree remove" in their repository, refusing
# local changes unless forced. Branches are kept. Worktrees of items are
# refused; they are removed by deleting the item.
cmd_worktrees_delete() {
  local wt key state label answer common force=() failed=0
  [[ $# -gt 0 ]] || exit 0
  init
  for wt in "$@"; do
    IFS=$'\t' read -r key state < <(worktree_owner "$wt")
    [[ -z "$key" ]] ||
      fail "${wt#"$FZFTASKS_WORKTREE_DIR"/} is the workspace of $key, delete the item instead (alt-x in fzftasks)"
  done
  if [[ $# -eq 1 ]]; then
    label="${1#"$FZFTASKS_WORKTREE_DIR"/}"
  else
    label="$# worktrees"
  fi
  answer="$(printf '%s\n' "No" "Yes" "Yes, force (discard local changes)" | fzf \
    --bind "ctrl-d:half-page-down" \
    --bind "ctrl-u:half-page-up" \
    --bind "alt-h:execute($SCRIPT --help | less -R)" \
    --prompt "$ICON_TRASH Delete $label: " \
    --height 100% \
    --reverse \
    --border rounded \
    --border-label " $ICON_TRASH Delete $label " \
    --border-label-pos center)"
  case "$answer" in
    Yes) ;;
    Yes,*) force=(--force) ;;
    *) exit 0 ;;
  esac

  for wt in "$@"; do
    common="$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
    if [[ -z "$common" ]]; then
      echo "Failed to find the repository of $wt, remove it manually"
      failed=1
    elif ! git -C "$(dirname "$common")" worktree remove "${force[@]}" "$wt"; then
      echo "Failed to remove the worktree $wt"
      failed=1
    fi
  done
  [[ "$failed" == 1 ]] && pause
}

cmd_worktrees() {
  init
  "$SCRIPT" __worktrees-list | fzf \
    --ansi \
    --delimiter $'\t' \
    --with-nth 2 \
    --reverse \
    --height 100% \
    --info right \
    --multi \
    --track \
    --id-nth 1 \
    --prompt "$ICON_TREE Worktrees: " \
    --border rounded \
    --border-label " $ICON_TREE fzftasks worktrees " \
    --border-label-pos center \
    --bind "ctrl-d:half-page-down" \
    --bind "ctrl-u:half-page-up" \
    --bind "alt-h:execute($SCRIPT --help | less -R)" \
    --bind "ctrl-f:preview-half-page-down" \
    --bind "ctrl-b:preview-half-page-up" \
    --bind "home:preview-top" \
    --bind "end:preview-bottom" \
    --bind "ctrl-p:toggle-preview" \
    --bind "tab:toggle+down" \
    --bind "shift-tab:toggle+up" \
    --bind "ctrl-r:reload-sync($SCRIPT __worktrees-list)+refresh-preview" \
    --bind "alt-x:execute($SCRIPT __worktrees-delete {+1})+deselect-all+reload-sync($SCRIPT __worktrees-list)" \
    --preview-window "right:50%" \
    --preview "$SCRIPT __worktrees-preview {1}"
}

usage() {
  cat <<'EOF'
fzftasks - Track work items and the pi agents working on them

Usage:
  fzftasks                browse all items
  fzftasks start <key>    start a new item: pick a repository (not for PRs and
                          not when --repo is given), a prompt and run pi in
                          the background (alt-enter: in the foreground, in an
                          interactive pi), or "Open" an interactive pi without
                          a run (or "Track" it as todo); opens an existing item
                          instead; new items require --title, --repo sets the
                          repository (empty for none) and --details - reads the
                          details from stdin
  fzftasks open <key>     open the item in a new Ghostty tab (or a new Rex
                          session when running in Rex) with an interactive pi
                          on its session
  fzftasks done <key>...  mark items as done
  fzftasks reply <key>    continue a waiting item in the background with a
                          reply written in $EDITOR
  fzftasks reopen <key>...
                          move done items back to waiting
  fzftasks new            create an ad-hoc item in $EDITOR, optionally in a
                          worktree of a repository
  fzftasks new --cwd      create an ad-hoc item in $EDITOR that works in the
                          current directory and start its pi in the current
                          terminal (no repository or prompt; deleting the
                          item keeps the directory)
  fzftasks worktrees      browse the worktrees in FZFTASKS_WORKTREE_DIR: other
                          worktrees (created manually or by an agent), which
                          fzftasks never removes, first, then the workspaces
                          of items

Track work items (pull requests, Jira work items, alerts, Kubernetes resources,
Slack threads and ad-hoc tasks) and the pi agents working on them. Each item has
its own pi session and workspace (a git worktree or a scratch directory). Agents
run in the background; when they finish, the item moves to waiting and can be
opened in Ghostty or Rex to continue the session.

Keybindings:
  enter  : start a todo item (pick a prompt or "Open"; alt-enter on a prompt
           runs it in the foreground), open all other items
  alt-s  : switch the preview between summary and session transcript
  alt-v  : view the item in its source (fzfgh view, fzfk, ...); does nothing
           for ad-hoc items
  alt-d  : mark items as done
  alt-r  : continue a waiting item in the background with a reply
  alt-w  : move done items back to waiting
  alt-x  : delete done items, their sessions and workspaces (external
           workspaces of "new --cwd" items are kept)
  alt-n  : new ad-hoc item
  ctrl-r : reload list (the list also reloads automatically, see
           FZFTASKS_REFRESH_INTERVAL)
  ctrl-p : toggle preview
  ctrl-d : scroll half page down
  ctrl-u : scroll half page up
  ctrl-f : scroll preview half page down
  ctrl-b : scroll preview half page up
  home   : scroll preview to top
  end    : scroll preview to bottom
  alt-h  : show help

Worktree keybindings (fzftasks worktrees):
  alt-x  : delete other worktrees (git worktree remove, optionally forced;
           branches are kept); workspaces of items are deleted with the item
  ctrl-r : reload list
  The list shows whether a worktree has changed files or commits that are on
  no remote; the preview shows them.

Environment:
  FZFTASKS_STATE_DIR        : database, log, sessions, workspaces and
                              notifications (default: ~/.local/state/fzftasks)
  FZFTASKS_CONFIG_DIR       : directory with the prompt templates in
                              prompts/*.md (default: ~/.config/fzftasks)
  FZFTASKS_GITHUB_DIR       : local clones as <dir>/<owner>/<repo>
                              (default: ~/Documents/GitHub)
  FZFTASKS_WORKTREE_DIR     : worktrees as <dir>/<owner>/<repo>/<branch>
                              (default: ~/.worktrees)
  FZFTASKS_PI               : pi binary (default: pi)
  FZFTASKS_REFRESH_INTERVAL : seconds between automatic reloads of the list
                              (default: 10)
EOF
}

cmd_pick() {
  init
  # Only runs that finish while the picker is open are notified.
  rm -f "$NOTIFY"/*
  clear
  # Identify fzftasks as the program of the item records (see status_item).
  status_report "state=idle:app=fzftasks"
  "$SCRIPT" __list | fzf \
    --ansi \
    --delimiter $'\t' \
    --with-nth 2 \
    --reverse \
    --height 100% \
    --info right \
    --multi \
    --track \
    --id-nth 1 \
    --prompt "$ICON_TASKS Tasks: " \
    --border rounded \
    --border-label " $ICON_TASKS fzftasks " \
    --border-label-pos center \
    --bind "ctrl-d:half-page-down" \
    --bind "ctrl-u:half-page-up" \
    --bind "alt-h:execute($SCRIPT --help | less -R)" \
    --bind "ctrl-f:preview-half-page-down" \
    --bind "ctrl-b:preview-half-page-up" \
    --bind "home:preview-top" \
    --bind "end:preview-bottom" \
    --bind "ctrl-p:toggle-preview" \
    --bind "tab:toggle+down" \
    --bind "shift-tab:toggle+up" \
    --bind "alt-s:transform($SCRIPT __preview-toggle)" \
    --bind "ctrl-r:reload-sync($SCRIPT __list)+refresh-preview" \
    --bind "every($FZFTASKS_REFRESH_INTERVAL):reload-sync($SCRIPT __list)+refresh-preview" \
    --bind "enter:execute($SCRIPT start {1})+reload-sync($SCRIPT __list)" \
    --bind "alt-v:execute($SCRIPT __action view {1})" \
    --bind "alt-d:execute-silent($SCRIPT done {+1})+deselect-all+reload-sync($SCRIPT __list)" \
    --bind "alt-r:execute($SCRIPT reply {1})+reload-sync($SCRIPT __list)" \
    --bind "alt-w:execute-silent($SCRIPT reopen {+1})+deselect-all+reload-sync($SCRIPT __list)" \
    --bind "alt-x:execute($SCRIPT __action delete {+1})+deselect-all+reload-sync($SCRIPT __list)" \
    --bind "alt-n:execute($SCRIPT new)+reload-sync($SCRIPT __list)" \
    --preview-window "right:65%" \
    --preview "$SCRIPT __preview {1}"
  # Remove all records of the picker from the terminal.
  status_report "state=clear"
}

# The dispatch is wrapped in a group with an "exit", so bash parses it
# completely before running it. Otherwise a long-running command (picker, pi)
# would continue reading this file at its old offset after it returns, which
# fails with syntax errors when the file was replaced in the meantime (e.g. by
# install.sh).
{
case "${1:-}" in
  "") cmd_pick ;;
  start)
    shift
    [[ -n "$1" ]] || exit 0
    cmd_start "$@"
    ;;
  open) cmd_open "$2" ;;
  done)
    shift
    cmd_done "$@"
    ;;
  reply) cmd_reply "$2" ;;
  reopen)
    shift
    cmd_reopen "$@"
    ;;
  new) cmd_new "$2" ;;
  worktrees) cmd_worktrees ;;
  __list) cmd_list ;;
  __worktrees-list) cmd_worktrees_list ;;
  __worktrees-preview) cmd_worktrees_preview "$2" ;;
  __worktrees-delete)
    shift
    cmd_worktrees_delete "$@"
    ;;
  __preview)
    shift
    cmd_preview "$@"
    ;;
  __preview-toggle) cmd_preview_toggle ;;
  __run)
    shift
    cmd_run "$@"
    ;;
  __action)
    shift
    cmd_action "$@"
    ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
exit
}
