#!/usr/bin/env bash

# fzfk - Fuzzy Finder for Kubernetes
#
# Usage: fzfk <resource> [kubectl get args...]

SCRIPT="$(realpath "$0")"

# ---------- Action handlers ----------
#
# Called recursively from fzf bindings as:
#   fzfk __action [<cluster_flag>...] -- <action> <resource> <namespace_or_-> <name>
#   fzfk __action [<cluster_flag>...] -- delete <resource> <all_ns> <fixed_ns_or_-> <row>...
#
# The optional <cluster_flag>s (e.g. --context=prod, --kubeconfig=/path) are
# the cluster selection flags given to fzfk, normalized to the --flag=value
# form. They are passed to every kubectl call, so actions operate on the same
# cluster as the listing.
#
# The sentinel "-" is used for the namespace when no namespace was given
# (i.e. the current kubectl context's namespace should be used). The delete
# action supports multiple rows and therefore uses its own argument layout;
# see the "delete" branch below.

if [[ "$1" == "__action" ]]; then
  shift
  cluster_args=()
  while [[ $# -gt 0 && "$1" != "--" ]]; do
    cluster_args+=("$1")
    shift
  done
  [[ "$1" == "--" ]] && shift
  action="$1"
  resource="$2"

  # The delete action can operate on several resources at once, so it uses a
  # dedicated argument layout:
  #   fzfk __action delete <resource> <all_ns> <fixed_ns_or_-> <row>...
  # Each <row> is a full "kubectl get" output line as passed by fzf's {+}
  # placeholder (the marked rows, or the row under the cursor when nothing is
  # marked). In -A mode the namespace is the row's first column and the name
  # its second; otherwise the name is the first column and the namespace is
  # <fixed_ns> ("-" for the context default).
  if [[ "$action" == "delete" ]]; then
    all_ns="$3"
    fixed_ns="$4"
    shift 4

    targets=()   # entries of the form "<namespace_or_->\t<name>"
    labels=()    # human-readable rows shown in the confirmation header
    for row in "$@"; do
      [[ -z "${row//[[:space:]]/}" ]] && continue
      if [[ "$all_ns" == "true" ]]; then
        row_ns="$(awk '{print $1}' <<<"$row")"
        row_name="$(awk '{print $2}' <<<"$row")"
      else
        row_ns="$fixed_ns"
        row_name="$(awk '{print $1}' <<<"$row")"
      fi
      [[ -z "$row_name" ]] && continue
      targets+=("$row_ns"$'\t'"$row_name")
      if [[ -n "$row_ns" && "$row_ns" != "-" ]]; then
        labels+=("$resource/$row_name (ns: $row_ns)")
      else
        labels+=("$resource/$row_name")
      fi
    done
    [[ ${#targets[@]} -eq 0 ]] && exit 0

    confirm="$(printf '%s\n' "No" "Yes" "Yes (force)" | fzf \
      --bind "ctrl-d:half-page-down" \
      --bind "ctrl-u:half-page-up" \
      --bind "alt-h:execute($SCRIPT --help | less -R)" \
      --prompt "󰩺 Delete ${#targets[@]} item(s): " \
      --height 100% \
      --reverse \
      --border rounded \
      --border-label " 󰩺 Delete ${#targets[@]} item(s) " \
      --border-label-pos center)"
    [[ "$confirm" != "Yes" && "$confirm" != "Yes (force)" ]] && exit 0

    force_args=()
    [[ "$confirm" == "Yes (force)" ]] && force_args=(--grace-period=0 --force)

    for target in "${targets[@]}"; do
      del_ns="${target%%$'\t'*}"
      del_name="${target#*$'\t'}"
      del_ns_arg=()
      [[ -n "$del_ns" && "$del_ns" != "-" ]] && del_ns_arg=(-n "$del_ns")
      kubectl "${cluster_args[@]}" delete "${del_ns_arg[@]}" "${force_args[@]}" "$resource" "$del_name"
    done
    read -n 1 -s -r -p "Press any key to continue..."
    exit 0
  fi

  namespace="$3"
  name="$4"

  ns_arg=()
  if [[ -n "$namespace" && "$namespace" != "-" ]]; then
    ns_arg=(-n "$namespace")
  fi

  case "$action" in
    describe)
      kubectl "${cluster_args[@]}" describe "${ns_arg[@]}" "$resource" "$name" | nvim -R -
      ;;

    yaml)
      kubectl "${cluster_args[@]}" get "${ns_arg[@]}" "$resource" "$name" -o yaml | nvim -R -
      ;;

    edit)
      kubectl "${cluster_args[@]}" edit "${ns_arg[@]}" "$resource" "$name"
      read -n 1 -s -r -p "Press any key to continue..."
      ;;

    logs)
      containers=$(kubectl "${cluster_args[@]}" get "${ns_arg[@]}" "$resource" "$name" -o jsonpath='{.spec.containers[*].name} {.spec.template.spec.containers[*].name} {.spec.initContainers[*].name} {.spec.template.spec.initContainers[*].name}' 2>/dev/null \
        | tr ' ' '\n' | awk 'NF && !seen[$0]++')
      if [[ -z "$containers" ]]; then
        echo "No containers found for $resource/$name"
        read -n 1 -s -r -p "Press any key to continue..."
        exit 0
      fi
      container=$(echo "$containers" | fzf \
        --bind "ctrl-d:half-page-down" \
        --bind "ctrl-u:half-page-up" \
        --bind "alt-h:execute($SCRIPT --help | less -R)" \
        --prompt "󰆧 Container: " \
        --height 100% \
        --reverse \
        --border rounded \
        --border-label " 󰆧 Logs $resource/$name " \
        --border-label-pos center)
      [[ -z "$container" ]] && exit 0
      kubectl "${cluster_args[@]}" logs "${ns_arg[@]}" "$resource/$name" -c "$container" --tail=500 -f
      ;;

    exec)
      containers=$(kubectl "${cluster_args[@]}" get "${ns_arg[@]}" "$resource" "$name" -o jsonpath='{.spec.containers[*].name} {.spec.template.spec.containers[*].name}' 2>/dev/null \
        | tr ' ' '\n' | awk 'NF && !seen[$0]++')
      if [[ -z "$containers" ]]; then
        echo "No containers found for $resource/$name"
        read -n 1 -s -r -p "Press any key to continue..."
        exit 0
      fi
      container=$(echo "$containers" | fzf \
        --bind "ctrl-d:half-page-down" \
        --bind "ctrl-u:half-page-up" \
        --bind "alt-h:execute($SCRIPT --help | less -R)" \
        --prompt "󰆧 Container: " \
        --height 100% \
        --reverse \
        --border rounded \
        --border-label " 󰆧 Exec $resource/$name " \
        --border-label-pos center)
      [[ -z "$container" ]] && exit 0
      kubectl "${cluster_args[@]}" exec "${ns_arg[@]}" -it "$resource/$name" -c "$container" -- \
        sh -c 'command -v bash >/dev/null 2>&1 && exec bash || exec sh'
      ;;

    portforward)
      ports=$(kubectl "${cluster_args[@]}" get "${ns_arg[@]}" "$resource" "$name" -o jsonpath='{.spec.containers[*].ports[*].containerPort} {.spec.template.spec.containers[*].ports[*].containerPort} {.spec.ports[*].port}' 2>/dev/null \
        | tr ' ' '\n' | awk 'NF && !seen[$0]++' | sort -n)
      if [[ -z "$ports" ]]; then
        echo "No ports found for $resource/$name"
        read -n 1 -s -r -p "Press any key to continue..."
        exit 0
      fi
      port=$(echo "$ports" | fzf \
        --bind "ctrl-d:half-page-down" \
        --bind "ctrl-u:half-page-up" \
        --bind "alt-h:execute($SCRIPT --help | less -R)" \
        --prompt "󰮏 Port: " \
        --height 100% \
        --reverse \
        --border rounded \
        --border-label " 󰮏 Port-forward $resource/$name " \
        --border-label-pos center)
      [[ -z "$port" ]] && exit 0
      # macOS ships bash 3.2, which lacks `read -i` for a prefilled prompt, so
      # the box is an fzf query seeded with the remote port over an empty
      # candidate list: Enter accepts, Esc cancels.
      local_port="$(fzf --print-query --query "$port" \
        --prompt "󰮏 Local port: " \
        --height 100% \
        --reverse \
        --border rounded \
        --border-label " 󰮏 Port-forward $resource/$name -> $port " \
        --border-label-pos center \
        --bind "alt-h:execute($SCRIPT --help | less -R)" \
        < /dev/null)"
      rc=$?
      # 0 = match accepted, 1 = query accepted (no match); anything else (130
      # Esc, 2 error) means cancel.
      [[ $rc -ne 0 && $rc -ne 1 ]] && exit 0
      local_port="$(printf '%s\n' "$local_port" | head -1)"
      local_port=${local_port:-$port}
      echo "Forwarding $resource/$name $local_port -> $port (Ctrl-C to stop)"
      kubectl "${cluster_args[@]}" port-forward "${ns_arg[@]}" "$resource/$name" "$local_port:$port"
      read -n 1 -s -r -p "Press any key to continue..."
      ;;

    *)
      echo "Unknown action: $action"
      exit 1
      ;;
  esac
  exit 0
fi

# ---------- Issues listing ----------
#
# Called as the list command in --issues mode (initially and on every reload):
#   fzfk __issues <kind> <all_ns> [kubectl get args...]
#
# Fetches the resources once as JSON and prints only the unhealthy ones as an
# aligned table, with the same leading columns as "kubectl get" (NAME, or
# NAMESPACE + NAME with -A), so all fzf bindings work unchanged. <kind> is one
# of the canonical kinds returned by issues_kind below. When nothing is
# unhealthy a single message line is printed, which fzf shows as the header.
#
# The pod STATUS / READY / RESTARTS columns approximate kubectl's own printer
# (init and sidecar containers, waiting / terminated reasons, Terminating);
# whether a pod is reported does not depend on that approximation.

if [[ "$1" == "__issues" ]]; then
  kind="$2"
  all_ns="$3"
  shift 3

  # Leave stderr alone: the caller merges it into the list, so kubectl errors
  # are shown as the header instead of a misleading "no issues" message.
  json="$(kubectl get "$kind" "$@" -o json)" || exit 1

  # shellcheck disable=SC2016
  filter='
    # Kubernetes timestamp -> epoch seconds (fractional seconds stripped).
    def ts: if . == null then null else sub("\\.[0-9]+"; "") | fromdateiso8601 end;

    # Kubernetes timestamp -> human readable age, like kubectl HumanDuration.
    def age:
      if . == null then "<unknown>" else
      ((now - ts) | floor) as $s
      | if $s < -1 then "<invalid>"
        elif $s < 0 then "0s"
        elif $s < 120 then "\($s)s"
        else (($s / 60) | floor) as $m
        | if $m < 10 then (if $s % 60 == 0 then "\($m)m" else "\($m)m\($s % 60)s" end)
          elif $m < 180 then "\($m)m"
          else (($m / 60) | floor) as $h
          | if $h < 8 then (if $m % 60 == 0 then "\($h)h" else "\($h)h\($m % 60)m" end)
            elif $h < 48 then "\($h)h"
            else (($h / 24) | floor) as $d
            | if $h < 192 then (if $h % 24 == 0 then "\($d)d" else "\($d)d\($h % 24)h" end)
              elif $h < 17520 then "\($d)d"
              elif $h < 70080 then (if $d % 365 == 0 then "\(($d / 365) | floor)y" else "\(($d / 365) | floor)y\($d % 365)d" end)
              else "\(($d / 365) | floor)y" end
            end
          end
        end
      end;

    # Reason of a terminated container state, like kubectl.
    def treason:
      if (.reason // "") != "" then .reason
      elif (.signal // 0) != 0 then "Signal:\(.signal)"
      else "ExitCode:\(.exitCode // 0)" end;

    # Pods: not Ready (and not Completed), or a container that restarted at
    # least $threshold times and crashed within the last $window seconds.
    def pod_row:
      . as $p
      | [($p.spec.initContainers // [])[] | select(.restartPolicy == "Always") | .name] as $sidecars
      | ($p.status.initContainerStatuses // []) as $ics
      | ($p.status.containerStatuses // []) as $cs
      | ($p.status.phase // "") as $phase
      | any($p.status.conditions[]?; .type == "Ready" and .status == "True") as $ready
      | any($p.status.conditions[]?; .type == "Initialized" and .status == "True") as $initialized
      | (if ($p.status.reason // "") != "" then $p.status.reason else $phase end) as $base
      | (if any($p.status.conditions[]?; .type == "PodScheduled" and .reason == "SchedulingGated")
         then "SchedulingGated" else $base end) as $base
      | ([$ics | to_entries[] | .key as $i | .value as $c
          | ($sidecars | any(. == $c.name)) as $sidecar
          | if $c.state.terminated != null and $c.state.terminated.exitCode == 0 then empty
            elif $sidecar and $c.started == true then empty
            elif $c.state.terminated != null then "Init:" + ($c.state.terminated | treason)
            elif ($c.state.waiting.reason // "") != "" and $c.state.waiting.reason != "PodInitializing"
              then "Init:" + $c.state.waiting.reason
            else "Init:\($i)/\($p.spec.initContainers | length)" end
        ] | .[0]) as $init_reason
      | (($init_reason == null) or $initialized) as $containers_started
      | (if $containers_started then
           ([$cs[]
             | if (.state.waiting.reason // "") != "" then .state.waiting.reason
               elif .state.terminated != null then (.state.terminated | treason)
               else empty end
           ] | .[0] // ($init_reason // $base)) as $reason
           | ([$cs[]
               | select((.state.waiting.reason // "") == "" and .state.terminated != null and .state.terminated.exitCode != 0)
               | .state.terminated | treason
             ] | .[0] // "") as $error_reason
           | any($cs[]; .ready == true and .state.running != null) as $has_running
           | if $reason != "Completed" then $reason
             elif $has_running and $ready then "Running"
             elif $error_reason != "" then $error_reason
             elif $has_running then "NotReady"
             else $reason end
         else $init_reason end) as $status
      | (if $p.metadata.deletionTimestamp != null and $p.status.reason == "NodeLost" then "Unknown"
         elif $p.metadata.deletionTimestamp != null and $phase != "Failed" and $phase != "Succeeded" then "Terminating"
         else $status end) as $status
      | select(($phase == "Succeeded" and $status == "Completed") | not)
      | (($ics + $cs)
         | any(.[]; (.restartCount // 0) >= $threshold
             and .lastState.terminated != null
             and (.lastState.terminated.exitCode // 0) != 0
             and ((.lastState.terminated.finishedAt | ts) // 0) > now - $window)
        ) as $recent_crash
      | select(($ready | not) or ($threshold > 0 and $recent_crash))
      | (if $containers_started
         then [($ics[] | select(.name as $n | $sidecars | any(. == $n))), $cs[]]
         else $ics end) as $counted
      | ([$counted[] | .restartCount // 0] | add // 0) as $restarts
      | ([$counted[] | .lastState.terminated.finishedAt // empty] | max) as $last_restart
      | ([$ics[] | select(.name as $n | $sidecars | any(. == $n)) | select(.started == true and .ready == true)] | length) as $ready_sidecars
      | ([$cs[] | select(.ready == true and .state.running != null)] | length) as $ready_containers
      | [
          "\($ready_sidecars + $ready_containers)/\(($p.spec.containers | length) + ($sidecars | length))",
          $status,
          (if $restarts != 0 and $last_restart != null then "\($restarts) (\($last_restart | age) ago)" else "\($restarts)" end),
          (.metadata.creationTimestamp | age)
        ];

    # Jobs: a Failed=True condition (BackoffLimitExceeded, DeadlineExceeded,
    # PodFailurePolicy, MaxFailedIndexesExceeded, ...).
    def job_row:
      ([.status.conditions[]? | select(.type == "Failed" and .status == "True")] | .[0]) as $c
      | select($c != null)
      | [$c.reason, (.metadata.creationTimestamp | age), $c.message];

    # Deployments / StatefulSets: ready, updated, available or current
    # replicas differ from the desired replicas.
    def replicas_row:
      (.spec.replicas // 1) as $desired
      | (.status.readyReplicas // 0) as $ready
      | (.status.updatedReplicas // 0) as $updated
      | (.status.availableReplicas // 0) as $available
      | select([$ready, $updated, $available, (.status.replicas // 0)] | any(. != $desired))
      | ["\($ready)/\($desired)", $updated, $available, (.metadata.creationTimestamp | age)];

    # DaemonSets: current, ready, updated or available pods differ from the
    # desired number, or pods run on nodes they should not run on.
    def daemonset_row:
      .status as $st
      | ($st.desiredNumberScheduled // 0) as $desired
      | select(
          ([($st.currentNumberScheduled // 0), ($st.numberReady // 0), ($st.updatedNumberScheduled // 0), ($st.numberAvailable // 0)] | any(. != $desired))
          or ($st.numberMisscheduled // 0) > 0)
      | [$desired, ($st.currentNumberScheduled // 0), ($st.numberReady // 0), ($st.updatedNumberScheduled // 0), ($st.numberAvailable // 0), (.metadata.creationTimestamp | age)];

    def kind_headers: {
      pods: ["READY", "STATUS", "RESTARTS", "AGE"],
      jobs: ["REASON", "AGE", "MESSAGE"],
      deployments: ["READY", "UP-TO-DATE", "AVAILABLE", "AGE"],
      statefulsets: ["READY", "UP-TO-DATE", "AVAILABLE", "AGE"],
      daemonsets: ["DESIRED", "CURRENT", "READY", "UP-TO-DATE", "AVAILABLE", "AGE"]
    }[$kind];

    def kind_row:
      if $kind == "pods" then pod_row
      elif $kind == "jobs" then job_row
      elif $kind == "daemonsets" then daemonset_row
      else replicas_row end;

    def id_cells: (if $allns then [.metadata.namespace] else [] end) + [.metadata.name];

    def cell: if . == null or . == "" then "<none>" else tostring end;

    [(if has("items") then .items[] else . end)
     | id_cells + kind_row
     | map(cell)
    ] as $rows
    | if ($rows | length) == 0 then "No \($kind) with issues found."
      else ((if $allns then ["NAMESPACE", "NAME"] else ["NAME"] end) + kind_headers), $rows[] | @tsv
      end
  '

  printf '%s' "$json" | jq -r \
    --arg kind "$kind" \
    --argjson allns "$all_ns" \
    --argjson threshold "${FZFK_ISSUES_RESTART_THRESHOLD:-3}" \
    --argjson window "${FZFK_ISSUES_RESTART_WINDOW:-86400}" \
    "$filter" \
  | awk -F '\t' '
      {
        nf[NR] = NF
        for (i = 1; i <= NF; i++) {
          cell[NR, i] = $i
          if (length($i) > width[i]) width[i] = length($i)
        }
      }
      END {
        for (r = 1; r <= NR; r++) {
          line = ""
          for (i = 1; i < nf[r]; i++) line = line sprintf("%-" (width[i] + 3) "s", cell[r, i])
          print line cell[r, nf[r]]
        }
      }'
  exit 0
fi

# Canonical kind for --issues mode, or failure when the resource is not
# supported.
issues_kind() {
  case "$1" in
    pods|pod|po) echo "pods" ;;
    jobs|job|jobs.batch|job.batch) echo "jobs" ;;
    deployments|deployment|deploy|deployments.apps|deployment.apps) echo "deployments" ;;
    statefulsets|statefulset|sts|statefulsets.apps|statefulset.apps) echo "statefulsets" ;;
    daemonsets|daemonset|ds|daemonsets.apps|daemonset.apps) echo "daemonsets" ;;
    *) return 1 ;;
  esac
}

# ---------- Main mode ----------

usage() {
  cat <<'EOF'
fzfk - Fuzzy Finder for Kubernetes

Usage: fzfk <resource> [--issues] [kubectl get args...]

Browse Kubernetes resources with fzf, previewing their details and performing
common actions, like describe, edit, delete, logs, exec, and port-forward.

With --issues only unhealthy resources are listed (requires jq). Supported
resources and when they are listed:
  pods          : not Ready (and not Completed), or a container restarted at
                  least FZFK_ISSUES_RESTART_THRESHOLD times and crashed within
                  the last FZFK_ISSUES_RESTART_WINDOW seconds
  jobs          : failed (e.g. BackoffLimitExceeded, DeadlineExceeded)
  deployments,
  statefulsets  : ready, up-to-date or available replicas differ from the
                  desired replicas
  daemonsets    : current, ready, up-to-date or available pods differ from the
                  desired number, or pods are misscheduled

Examples:
  fzfk pods
  fzfk pods -w
  fzfk pods -A --watch
  fzfk pods -n kube-system
  fzfk deployments -l app=foo
  fzfk pods --context prod -A
  fzfk pods -A --issues -w
  fzfk deployments --issues -n kube-system

Keybindings:
  enter  : describe the resource under the cursor
  alt-p  : port-forward
  alt-x  : exec into container
  alt-l  : show container logs
  alt-y  : open manifest
  alt-e  : edit manifest
  alt-d  : delete marked resources; the confirmation offers a force option
           (--grace-period=0 --force)
  alt-w  : toggle watch mode (auto-refresh) on/off
  ctrl-r : reload list
  ctrl-p : toggle preview
  ctrl-d : scroll half page down
  ctrl-u : scroll half page up
  ctrl-f : scroll preview half page down
  ctrl-b : scroll preview half page up
  home   : scroll preview to top
  end    : scroll preview to bottom
  alt-h  : show help

Environment:
  FZFK_REFRESH_INTERVAL         : seconds between watch refreshes (default: 5)
  FZFK_ISSUES_RESTART_THRESHOLD : minimum restarts for a Ready pod with a recent
                                  crash to be listed; 0 disables (default: 3)
  FZFK_ISSUES_RESTART_WINDOW    : seconds a crash counts as recent
                                  (default: 86400)
EOF
}

if [[ -z "$1" || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

RESOURCE="$1"
shift
KUBECTL_ARGS=("$@")

# Parse namespace flags from kubectl args, so action handlers can
# operate on the same namespace as the listing. The -w / --watch flags are
# intercepted here to control fzfk's own watch (auto-refresh) mode and are
# stripped from the arguments forwarded to kubectl (kubectl get is run once per
# refresh, so its own --watch must never be passed through).
#
# Cluster selection flags are collected in CLUSTER_ARGS (normalized to the
# --flag=value form) so the preview and the action handlers target the same
# cluster as the listing; they are also kept in the arguments for kubectl get.
NAMESPACE=""
ALL_NS=false
WATCH=false
ISSUES=false
FILTERED_ARGS=()
CLUSTER_ARGS=()
i=0
while [[ $i -lt ${#KUBECTL_ARGS[@]} ]]; do
  arg="${KUBECTL_ARGS[$i]}"
  case "$arg" in
    -w|--watch)
      WATCH=true
      i=$((i+1))
      continue
      ;;
    --issues)
      ISSUES=true
      i=$((i+1))
      continue
      ;;
    -A|--all-namespaces)
      ALL_NS=true
      ;;
    -n|--namespace)
      FILTERED_ARGS+=("$arg")
      i=$((i+1))
      NAMESPACE="${KUBECTL_ARGS[$i]}"
      FILTERED_ARGS+=("${KUBECTL_ARGS[$i]}")
      i=$((i+1))
      continue
      ;;
    --namespace=*)
      NAMESPACE="${arg#*=}"
      ;;
    --context|--kubeconfig|--cluster|--user|-s|--server)
      flag="$arg"
      [[ "$flag" == "-s" ]] && flag="--server"
      FILTERED_ARGS+=("$arg")
      i=$((i+1))
      CLUSTER_ARGS+=("$flag=${KUBECTL_ARGS[$i]}")
      FILTERED_ARGS+=("${KUBECTL_ARGS[$i]}")
      i=$((i+1))
      continue
      ;;
    --context=*|--kubeconfig=*|--cluster=*|--user=*|--server=*)
      CLUSTER_ARGS+=("$arg")
      ;;
  esac
  FILTERED_ARGS+=("$arg")
  i=$((i+1))
done
# Arguments forwarded to kubectl, with fzfk's own -w / --watch / --issues
# removed.
KUBECTL_ARGS=("${FILTERED_ARGS[@]}")

if $ISSUES; then
  if ! ISSUES_KIND="$(issues_kind "$RESOURCE")"; then
    echo "fzfk: --issues is not supported for '$RESOURCE' (supported: pods, jobs, deployments, statefulsets, daemonsets)" >&2
    exit 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "fzfk: --issues requires jq" >&2
    exit 1
  fi
fi

# Determine field positions used by the fzf bindings.
#   - With -A / --all-namespaces the kubectl output starts with the
#     NAMESPACE column, so we read it from field {1} and the name from {2}.
#   - Otherwise the namespace is fixed (or "-" for the context default)
#     and the name is the first field.
if $ALL_NS; then
  NS_FIELD="{1}"
  NAME_FIELD="{2}"
elif [[ -n "$NAMESPACE" ]]; then
  NS_FIELD="$NAMESPACE"
  NAME_FIELD="{1}"
else
  NS_FIELD="-"
  NAME_FIELD="{1}"
fi

# Identity fields for --track / --id-nth so marked rows and the cursor survive
# reloads even as volatile columns (STATUS, AGE, ...) change, plus the fixed
# namespace token handed to the delete handler.
#   - With -A the identity is the NAMESPACE + NAME columns (fields 1 and 2) and
#     the per-row namespace comes from the row itself, so the token is "-".
#   - Otherwise the identity is the NAME column (field 1) and the namespace is
#     fixed (or "-" for the context default).
if $ALL_NS; then
  ID_NTH="1,2"
  NS_TOKEN="-"
elif [[ -n "$NAMESPACE" ]]; then
  ID_NTH="1"
  NS_TOKEN="$NAMESPACE"
else
  ID_NTH="1"
  NS_TOKEN="-"
fi

LIST_CMD="kubectl get $RESOURCE ${KUBECTL_ARGS[*]}"

# Command actually run to populate the list. Merge stderr into stdout so
# kubectl's diagnostics (e.g. "No resources found in <ns> namespace." when the
# list is empty, or genuine errors) become normal input rather than being
# written straight to the terminal, where they would overwrite fzf's TUI and
# break its layout. The message is then consumed by --header-lines=1 and shown
# as the header while the list stays empty. $LIST_CMD itself is kept clean for
# display in the border label.
LIST_CMD_RUN="$LIST_CMD 2>&1"

# In --issues mode the list comes from the __issues handler instead, which
# prints the unhealthy resources in the same column layout. The label keeps
# showing the underlying kubectl command, marked as filtered.
LIST_LABEL="$LIST_CMD"
LIST_MODE=""
if $ISSUES; then
  LIST_CMD_RUN="$(printf '%q ' "$SCRIPT" __issues "$ISSUES_KIND" "$ALL_NS" "${KUBECTL_ARGS[@]}")2>&1"
  LIST_MODE="issues, "
fi

# Interval (seconds) between watch refreshes of the listed resources
# (override via FZFK_REFRESH_INTERVAL).
FZFK_REFRESH_INTERVAL="${FZFK_REFRESH_INTERVAL:-5}"

# Watch mode (auto-refresh) on/off is stored in a small state file so it can be
# toggled at runtime (alt-w) and read back by the periodic timer. The timer
# reloads only while the file contains "on"; toggling to "off" pauses the watch
# so the input field and list navigation stay responsive (--track blocks the UI
# while fzf searches the reloaded stream for the item under the cursor). The
# initial state mirrors kubectl's -w / --watch flag: on when it was passed,
# off otherwise.
if $WATCH; then
  WATCH_INITIAL="on"
else
  WATCH_INITIAL="off"
fi
WATCH_STATE_FILE="$(mktemp -t fzfk_watch.XXXXXX)"
printf '%s' "$WATCH_INITIAL" >"$WATCH_STATE_FILE"
trap 'rm -f "$WATCH_STATE_FILE"' EXIT

WATCH_LABEL_ON="󱃾 $LIST_LABEL  (${LIST_MODE}watch: on) "
WATCH_LABEL_OFF="󱃾 $LIST_LABEL  (${LIST_MODE}watch: off) "
if $WATCH; then
  WATCH_LABEL_INITIAL="$WATCH_LABEL_ON"
else
  WATCH_LABEL_INITIAL="$WATCH_LABEL_OFF"
fi

# Periodic refresh, gated on the state file: the timer runs a transform that
# emits a reload-sync action only while watch is "on", and nothing otherwise.
# reload-sync (rather than reload) swaps the list only once the new output is
# ready, avoiding the flicker of an emptied list and preserving marked rows;
# kubectl get returns quickly, so the tracking block it holds is brief.
WATCH_BIND="every($FZFK_REFRESH_INTERVAL):transform:[ \"\$(cat '$WATCH_STATE_FILE')\" = on ] && echo 'reload-sync($LIST_CMD_RUN)' || true"

# Toggle watch mode and reflect the new state in the border label. Turning it
# back on also triggers an immediate reload so the list is up to date at once.
WATCH_TOGGLE_BIND="alt-w:transform:if [ \"\$(cat '$WATCH_STATE_FILE')\" = on ]; then printf off >'$WATCH_STATE_FILE'; echo 'change-border-label( $WATCH_LABEL_OFF)'; else printf on >'$WATCH_STATE_FILE'; echo 'change-border-label( $WATCH_LABEL_ON)+reload-sync($LIST_CMD_RUN)'; fi"

# Cluster selection flags, shell-quoted for embedding in the fzf command
# strings below (empty when none were given).
CLUSTER_ARGS_STR=""
if [[ ${#CLUSTER_ARGS[@]} -gt 0 ]]; then
  CLUSTER_ARGS_STR="$(printf ' %q' "${CLUSTER_ARGS[@]}")"
fi

# Build the per-row preview command (kubectl describe under the cursor).
if $ALL_NS; then
  PREVIEW_CMD="kubectl$CLUSTER_ARGS_STR describe $RESOURCE -n {1} {2}"
elif [[ -n "$NAMESPACE" ]]; then
  PREVIEW_CMD="kubectl$CLUSTER_ARGS_STR describe $RESOURCE -n $NAMESPACE {1}"
else
  PREVIEW_CMD="kubectl$CLUSTER_ARGS_STR describe $RESOURCE {1}"
fi

ACTION="$SCRIPT __action$CLUSTER_ARGS_STR --"

clear
fzf \
  --ansi \
  --reverse \
  --height 100% \
  --header-lines=1 \
  --info right \
  --prompt "󱃾 $RESOURCE: " \
  --multi \
  --track \
  --id-nth "$ID_NTH" \
  --border "rounded" \
  --border-label " $WATCH_LABEL_INITIAL" \
  --border-label-pos center \
  --bind "ctrl-d:half-page-down" \
  --bind "ctrl-u:half-page-up" \
  --bind "alt-h:execute($SCRIPT --help | less -R)" \
  --bind "ctrl-f:preview-half-page-down" \
  --bind "ctrl-b:preview-half-page-up" \
  --bind "home:preview-top" \
  --bind "end:preview-bottom" \
  --bind "ctrl-p:toggle-preview" \
  --bind "ctrl-r:reload-sync($LIST_CMD_RUN)" \
  --bind "$WATCH_BIND" \
  --bind "$WATCH_TOGGLE_BIND" \
  --bind "enter:execute($ACTION describe $RESOURCE $NS_FIELD $NAME_FIELD)" \
  --bind "alt-p:execute($ACTION portforward $RESOURCE $NS_FIELD $NAME_FIELD)" \
  --bind "alt-x:execute($ACTION exec $RESOURCE $NS_FIELD $NAME_FIELD)" \
  --bind "alt-l:execute($ACTION logs $RESOURCE $NS_FIELD $NAME_FIELD)" \
  --bind "alt-y:execute($ACTION yaml $RESOURCE $NS_FIELD $NAME_FIELD)" \
  --bind "alt-e:execute($ACTION edit $RESOURCE $NS_FIELD $NAME_FIELD)" \
  --bind "alt-d:execute($ACTION delete $RESOURCE $ALL_NS $NS_TOKEN {+})+reload-sync($LIST_CMD_RUN)" \
  --preview-window "right:65%" \
  --preview "$PREVIEW_CMD" \
  < <(eval "$LIST_CMD_RUN")
